/-- Membership in one of the 146 exact leading-`b` terminal chambers. -/
def FirstBZeroTailCandidate (x y j z : Nat) : Prop :=
  ∃ i, i < 146 ∧
    x = firstBZeroTailX i ∧
    y = firstBZeroTailY i ∧
    j = firstBZeroTailPosition i ∧
    firstBZeroTailLower i ≤ z ∧
    match firstBZeroTailUpper i with
    | none => True
    | some upper => z ≤ upper

