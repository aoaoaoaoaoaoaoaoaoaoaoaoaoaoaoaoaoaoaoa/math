    FirstBOneX211LargeInnerCandidate j y := by
  have y_lower := firstBOneX211_y_lower_of_large_inner_envelope j y z envelope
  have position_bound :=
    firstBOneX211_position_lt_thirteen_of_large_inner_envelope
      j y z y_lower y_upper z_large envelope
  have position_le : j ≤ 12 := by omega
  interval_cases j
  · have bounds := largeInner_j0_bounds y z z_large envelope
    exact Or.inl ⟨rfl, bounds.1, bounds.2⟩
  · have bounds := largeInner_j1_bounds y z z_large envelope
    exact Or.inr (Or.inl ⟨rfl, bounds.1, bounds.2⟩)
  · have bounds := largeInner_j2_bounds y z z_large envelope
    exact Or.inr (Or.inr (Or.inl ⟨rfl, bounds.1, bounds.2⟩))
  · have bounds := largeInner_j3_bounds y z z_large envelope
    exact Or.inr (Or.inr (Or.inr ⟨rfl, bounds.1, bounds.2⟩))
  · have bounds := largeInner_j4_bounds y z z_large envelope
