    (core : FirstBOneX211SuffixCore body (firstBOneX211SuffixH j y z)
      (firstBOneX211J y z) (firstBOneX211B y z)) : False := by
  unfold FirstBOneX211LargeInnerCandidate at candidate
  rcases candidate with first | second | third | fourth
  · rcases first with ⟨rfl, y_lower, y_upper⟩
    have chamber :
        (39701 ≤ y ∧ y ≤ 39726) ∨
          (39727 ≤ y ∧ y ≤ 39752) ∨
          (39753 ≤ y ∧ y ≤ 39778) ∨
          (39779 ≤ y ∧ y ≤ 39804) ∨
