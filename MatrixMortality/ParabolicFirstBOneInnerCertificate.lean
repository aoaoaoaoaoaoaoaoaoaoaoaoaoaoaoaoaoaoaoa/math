  · have bounds := largeInner_j5_bounds y z z_large envelope
    omega
  · have bounds := largeInner_j6_bounds y z z_large envelope
    omega
  · have bounds := largeInner_j7_bounds y z z_large envelope
    omega
  · have bounds := largeInner_j8_bounds y z z_large envelope
