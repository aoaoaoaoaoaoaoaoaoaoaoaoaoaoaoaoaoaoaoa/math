import MatrixMortality.AffineRecognizer
import MatrixMortality.BranchingHistory
import MatrixMortality.PrefixResidual

/-!
# Exact three-state recognition of the branching `bcbc` language

The width-three body `bcbc` has null histories generated by nested excursions
`X (D Z)ⁿ F`. This file first proves that grammar from a canonical residual path. It then
constructs a singular three-state affine system recognizing every terminal control word,
including malformed phase patterns and adjacent toggles.
-/

namespace MatrixMortality

namespace BranchingRecognizer

open BranchingHistory PeriodicHistory PrefixResidual
open scoped Matrix

/-! ## Exact null-history grammar -/

/-- The stroke `bcb`, used to descend one residual level. -/
abbrev descentStroke : Stroke TagLetter 3 := strokeBCB

/-- The stroke `cbb`, used to return one residual level. -/
abbrev ascentStroke : Stroke TagLetter 3 := strokeCBB

private abbrev Residual := PrefixResidual.Residual TagLetter

private def startResidual : Residual := .right .b []

private def leftResidual : Residual := .left .b []

private def deepResidual : Residual := .left .b [.c, .b]

private def outputBlock (stroke : Stroke TagLetter 3) : List TagLetter :=
  tagOutput bcbcBody stroke.head

private abbrev ResidualStep (before : Residual) (stroke : Stroke TagLetter 3)
    (after : Residual) : Prop :=
  before.leftWord ++ stroke.letters ++ after.rightWord =
    before.rightWord ++ outputBlock stroke ++ after.leftWord

private abbrev ResidualPath (initial : Residual) :
    List (Stroke TagLetter 3) → Residual → Prop :=
  PrefixResidual.Path (tagOutput bcbcBody) initial

private theorem bcbcNull_iff_path (history : List (Stroke TagLetter 3)) :
    bcbcNull history ↔ ResidualPath startResidual history startResidual := by
  constructor
  · intro null
    apply PrefixResidual.path_of_completion (tagOutput bcbcBody) .b startResidual [] [.b] history
    · rfl
    · simpa [bcbcNull] using null
  · intro path
    have realized := PrefixResidual.Path.realizes path (left := []) (right := [.b]) (by rfl)
    simpa [bcbcNull, Residual.Realizes, startResidual, Residual.leftWord,
      Residual.rightWord] using realized

private def rightRigid : Residual → Prop
  | .right head tail => head = .b ∧ tail = []
  | .flush | .left _ _ => True

private theorem start_rightRigid : rightRigid startResidual := by simp [rightRigid, startResidual]

private theorem rightRigid_step {before after : Residual}
    {stroke : Stroke TagLetter 3} (rigid : rightRigid before)
    (step : ResidualStep before stroke after) : rightRigid after := by
  cases after with
  | flush => trivial
  | left => trivial
  | right afterHead afterTail =>
      rcases stroke with ⟨strokeHead, wake, width⟩
      have wakeLength : wake.length = 2 := by omega
      obtain ⟨wake₁, wake₂, rfl⟩ := List.length_eq_two.mp wakeLength
      cases before with
      | flush =>
          cases strokeHead <;>
            simp [ResidualStep, Residual.leftWord, Residual.rightWord, outputBlock,
              Stroke.letters, bcbcBody, tagOutput, nearyBody] at step
      | right beforeHead beforeTail =>
          rcases rigid with ⟨rfl, rfl⟩
          cases strokeHead <;>
            simp [ResidualStep, Residual.leftWord, Residual.rightWord, outputBlock,
              Stroke.letters, bcbcBody, tagOutput, nearyBody] at step
      | left beforeHead beforeTail =>
          cases strokeHead with
          | b =>
              have lengths := congrArg List.length step
              simp [Residual.leftWord, Residual.rightWord, outputBlock,
                Stroke.letters, tagOutput, nearyBody] at lengths
          | c =>
              have lengths := congrArg List.length step
              simp [Residual.leftWord, Residual.rightWord, outputBlock,
                Stroke.letters, bcbcBody, tagOutput, nearyBody] at lengths
              have beforeTailEmpty : beforeTail = [] :=
                List.length_eq_zero_iff.mp (by omega)
              have afterTailEmpty : afterTail = [] :=
                List.length_eq_zero_iff.mp (by omega)
              subst beforeTail
              subst afterTail
              simp [ResidualStep, Residual.leftWord, Residual.rightWord, outputBlock,
                Stroke.letters, bcbcBody, tagOutput, nearyBody] at step
              simpa [rightRigid] using step.2.2.2

private theorem preserves_rightRigid {initial final : Residual}
    {history : List (Stroke TagLetter 3)} (path : ResidualPath initial history final)
    (rigid : rightRigid initial) : rightRigid final := by
  induction path with
  | nil => exact rigid
  | snoc _ step induction => exact rightRigid_step induction step

private theorem enters_start {before : Residual} {stroke : Stroke TagLetter 3}
    (rigid : rightRigid before) (step : ResidualStep before stroke startResidual) :
    before = leftResidual ∧ stroke = strokeCBC := by
  rcases stroke with ⟨head, wake, width⟩
  have wakeLength : wake.length = 2 := by omega
  obtain ⟨wake₁, wake₂, rfl⟩ := List.length_eq_two.mp wakeLength
  cases before with
  | flush =>
      cases head <;>
        simp [ResidualStep, Residual.leftWord, Residual.rightWord, startResidual,
          outputBlock, Stroke.letters, bcbcBody, tagOutput, nearyBody] at step
  | right beforeHead beforeTail =>
      rcases rigid with ⟨rfl, rfl⟩
      cases head <;>
        simp [ResidualStep, Residual.leftWord, Residual.rightWord, startResidual,
          outputBlock, Stroke.letters, bcbcBody, tagOutput, nearyBody] at step
  | left beforeHead beforeTail =>
      cases head with
      | b =>
          have lengths := congrArg List.length step
          simp [Residual.leftWord, Residual.rightWord, startResidual,
            outputBlock, Stroke.letters, tagOutput, nearyBody] at lengths
      | c =>
          have lengths := congrArg List.length step
          simp [Residual.leftWord, Residual.rightWord, startResidual,
            outputBlock, Stroke.letters, bcbcBody, tagOutput, nearyBody] at lengths
          subst beforeTail
          cases wake₁ <;> cases wake₂ <;>
            simp_all [ResidualStep, Residual.leftWord, Residual.rightWord, startResidual,
              leftResidual, outputBlock, strokeCBC, stroke₃, Stroke.letters, bcbcBody,
              tagOutput, nearyBody]

private theorem enters_left {before : Residual} {stroke : Stroke TagLetter 3}
    (rigid : rightRigid before) (step : ResidualStep before stroke leftResidual) :
    (before = startResidual ∧ stroke = strokeBBB) ∨
      (before = deepResidual ∧ stroke = strokeCBB) := by
  rcases stroke with ⟨head, wake, width⟩
  have wakeLength : wake.length = 2 := by omega
  obtain ⟨wake₁, wake₂, rfl⟩ := List.length_eq_two.mp wakeLength
  cases before with
  | flush =>
      cases head <;>
        simp [ResidualStep, Residual.leftWord, Residual.rightWord, leftResidual,
          outputBlock, Stroke.letters, bcbcBody, tagOutput, nearyBody] at step
  | right beforeHead beforeTail =>
      rcases rigid with ⟨rfl, rfl⟩
      cases head <;> cases wake₁ <;> cases wake₂ <;>
        simp [ResidualStep, Residual.leftWord, Residual.rightWord, startResidual,
          leftResidual, outputBlock, strokeBBB, stroke₃, Stroke.letters, bcbcBody,
          tagOutput, nearyBody] at step ⊢
  | left beforeHead beforeTail =>
      cases head with
      | b =>
          have lengths := congrArg List.length step
          simp [Residual.leftWord, Residual.rightWord, leftResidual,
            outputBlock, Stroke.letters, tagOutput, nearyBody] at lengths
      | c =>
          have lengths := congrArg List.length step
          simp [Residual.leftWord, Residual.rightWord, leftResidual,
            outputBlock, Stroke.letters, bcbcBody, tagOutput, nearyBody] at lengths
          obtain ⟨tail₁, tail₂, rfl⟩ := List.length_eq_two.mp (by omega : beforeTail.length = 2)
          cases tail₁ <;> cases tail₂ <;> cases wake₁ <;> cases wake₂ <;>
            simp_all [ResidualStep, Residual.leftWord, Residual.rightWord, leftResidual,
              deepResidual, outputBlock, strokeCBB, stroke₃, Stroke.letters, bcbcBody,
              tagOutput, nearyBody]

private theorem enters_deep {before : Residual} {stroke : Stroke TagLetter 3}
    (rigid : rightRigid before) (step : ResidualStep before stroke deepResidual) :
    before = leftResidual ∧ stroke = strokeBCB := by
  rcases stroke with ⟨head, wake, width⟩
  have wakeLength : wake.length = 2 := by omega
  obtain ⟨wake₁, wake₂, rfl⟩ := List.length_eq_two.mp wakeLength
  cases before with
  | flush =>
      cases head <;>
        simp [ResidualStep, Residual.leftWord, Residual.rightWord, deepResidual,
          outputBlock, Stroke.letters, bcbcBody, tagOutput, nearyBody] at step
  | right beforeHead beforeTail =>
      rcases rigid with ⟨rfl, rfl⟩
      cases head <;>
        simp [ResidualStep, Residual.leftWord, Residual.rightWord, deepResidual,
          outputBlock, Stroke.letters, bcbcBody, tagOutput, nearyBody] at step
  | left beforeHead beforeTail =>
      cases head with
      | b =>
          have lengths := congrArg List.length step
          simp [Residual.leftWord, Residual.rightWord, deepResidual,
            outputBlock, Stroke.letters, tagOutput, nearyBody] at lengths
          subst beforeTail
          cases wake₁ <;> cases wake₂ <;>
            simp_all [ResidualStep, Residual.leftWord, Residual.rightWord, leftResidual,
              deepResidual, outputBlock, strokeBCB, stroke₃, Stroke.letters,
              tagOutput, nearyBody]
      | c =>
          have lengths := congrArg List.length step
          simp [Residual.leftWord, Residual.rightWord, deepResidual,
            outputBlock, Stroke.letters, bcbcBody, tagOutput, nearyBody] at lengths
          have beforeLength : (beforeHead :: beforeTail).length =
              (outputBlock ⟨.c, [wake₁, wake₂], width⟩).length := by
            simp [outputBlock, bcbcBody, tagOutput, nearyBody]
            omega
          have rawEquality : (beforeHead :: beforeTail) ++ [.c, wake₁, wake₂] =
              [.b, .c, .b, .c, .b] ++ [.b, .c, .b] := by
            simpa [ResidualStep, Residual.leftWord, Residual.rightWord, deepResidual,
              outputBlock, Stroke.letters, bcbcBody, tagOutput, nearyBody,
              List.append_assoc] using step
          have prefixLength : (beforeHead :: beforeTail).length =
              ([TagLetter.b, .c, .b, .c, .b] : List TagLetter).length := by
            simpa [outputBlock, bcbcBody, tagOutput, nearyBody] using beforeLength
          have strokeEquality := List.append_inj_right rawEquality prefixLength
          simp at strokeEquality

private theorem step_start_left :
    ResidualStep startResidual strokeBBB leftResidual := by rfl

private theorem step_left_deep :
    ResidualStep leftResidual strokeBCB deepResidual := by rfl

private theorem step_deep_left :
    ResidualStep deepResidual strokeCBB leftResidual := by rfl

private theorem step_left_start :
    ResidualStep leftResidual strokeCBC startResidual := by rfl

/-- The internal word `(D Z)ⁿ` of a nested null excursion. -/
def nestedCore : Nat → List (Stroke TagLetter 3)
  | 0 => []
  | depth + 1 => nestedCore depth ++ [strokeBCB, strokeCBB]

/-- One null excursion `X (D Z)ⁿ F`. -/
def nullExcursion (depth : Nat) : List (Stroke TagLetter 3) :=
  strokeBBB :: nestedCore depth ++ [strokeCBC]

/-- Concatenate the excursions selected by a list of nesting depths. -/
def nullHistory : List Nat → List (Stroke TagLetter 3)
  | [] => []
  | depth :: depths => nullExcursion depth ++ nullHistory depths

@[simp] theorem nullHistory_append (left right : List Nat) :
    nullHistory (left ++ right) = nullHistory left ++ nullHistory right := by
  induction left with
  | nil => rfl
  | cons depth depths induction => simp [nullHistory, induction, List.append_assoc]

private theorem nestedCore_path (depth : Nat) :
    ResidualPath leftResidual (nestedCore depth) leftResidual := by
  induction depth with
  | zero => exact PrefixResidual.Path.nil
  | succ depth induction =>
      exact PrefixResidual.Path.append induction
        (PrefixResidual.Path.cons step_left_deep
          (PrefixResidual.Path.snoc PrefixResidual.Path.nil step_deep_left))

private theorem nullExcursion_path (depth : Nat) :
    ResidualPath startResidual (nullExcursion depth) startResidual := by
  apply PrefixResidual.Path.cons step_start_left
  exact PrefixResidual.Path.append (nestedCore_path depth)
    (PrefixResidual.Path.snoc PrefixResidual.Path.nil step_left_start)

private theorem nullHistory_path (depths : List Nat) :
    ResidualPath startResidual (nullHistory depths) startResidual := by
  induction depths with
  | nil => exact PrefixResidual.Path.nil
  | cons depth depths induction =>
      exact PrefixResidual.Path.append (nullExcursion_path depth) induction

private theorem path_to_left_split {history : List (Stroke TagLetter 3)}
    (path : ResidualPath startResidual history leftResidual) :
    ∃ priorHistory depth,
      ResidualPath startResidual priorHistory startResidual ∧
        history = priorHistory ++ strokeBBB :: nestedCore depth := by
  have nonempty : history ≠ [] := by
    intro empty
    subst history
    have realized := PrefixResidual.Path.realizes path
      (left := []) (right := [.b]) (by rfl)
    simp [Residual.Realizes, leftResidual, Residual.leftWord,
      Residual.rightWord] at realized
  obtain ⟨priorHistory, before, stroke, history_eq, priorPath, finalStep⟩ :=
    path.snoc_of_ne_nil nonempty
  have beforeRigid := preserves_rightRigid priorPath start_rightRigid
  rcases enters_left beforeRigid finalStep with entrance | entrance
  · rcases entrance with ⟨rfl, rfl⟩
    exact ⟨priorHistory, 0, priorPath, by simpa [nestedCore] using history_eq⟩
  · rcases entrance with ⟨rfl, rfl⟩
    have priorNonempty : priorHistory ≠ [] := by
      intro empty
      subst priorHistory
      have realized := PrefixResidual.Path.realizes priorPath
        (left := []) (right := [.b]) (by rfl)
      simp [Residual.Realizes, deepResidual, Residual.leftWord,
        Residual.rightWord] at realized
    obtain ⟨earlier, before', stroke', prior_eq, earlierPath, deepStep⟩ :=
      priorPath.snoc_of_ne_nil priorNonempty
    have beforeRigid' := preserves_rightRigid earlierPath start_rightRigid
    obtain ⟨rfl, rfl⟩ := enters_deep beforeRigid' deepStep
    obtain ⟨base, depth, basePath, equality⟩ := path_to_left_split earlierPath
    refine ⟨base, depth + 1, basePath, ?_⟩
    simp [history_eq, prior_eq, equality, nestedCore, List.append_assoc]
termination_by history.length
decreasing_by
  rw [history_eq, prior_eq]
  simp

private theorem path_classify {history : List (Stroke TagLetter 3)}
    (path : ResidualPath startResidual history startResidual) :
    ∃ depths, history = nullHistory depths := by
  by_cases empty : history = []
  · exact ⟨[], by simp [empty, nullHistory]⟩
  · obtain ⟨priorHistory, before, stroke, history_eq, priorPath, finalStep⟩ :=
      path.snoc_of_ne_nil empty
    have beforeRigid := preserves_rightRigid priorPath start_rightRigid
    obtain ⟨rfl, rfl⟩ := enters_start beforeRigid finalStep
    obtain ⟨base, depth, basePath, prior_eq⟩ := path_to_left_split priorPath
    obtain ⟨depths, base_eq⟩ := path_classify basePath
    refine ⟨depths ++ [depth], ?_⟩
    simp [history_eq, prior_eq, base_eq, nullHistory, nullExcursion, List.append_assoc]
termination_by history.length
decreasing_by
  rw [history_eq, prior_eq]
  simp

/-- Complete grammar of the `bcbc` null histories:
`(X (D Z)ⁿ F)*`, with an independently chosen depth for each excursion. -/
theorem bcbcNull_iff (history : List (Stroke TagLetter 3)) :
    bcbcNull history ↔ ∃ depths, history = nullHistory depths := by
  rw [bcbcNull_iff_path]
  constructor
  · exact path_classify
  · rintro ⟨depths, rfl⟩
    exact nullHistory_path depths

/-! ## Exact terminal-history grammar -/

private def bcbcTail (history : List (Stroke TagLetter 3)) : Prop :=
  consumed history ++ [.b] = [.b, .c, .b] ++
    produced (tagOutput bcbcBody) history

private theorem bcbcTail_iff (history : List (Stroke TagLetter 3)) :
    bcbcTail history ↔
      ∃ tail, history = strokeBCB :: tail ∧ bcbcNull tail := by
  cases history with
  | nil => simp [bcbcTail]
  | cons first tail =>
      rcases first with ⟨head, wake, width⟩
      have wakeLength : wake.length = 2 := by omega
      obtain ⟨wake₁, wake₂, rfl⟩ := List.length_eq_two.mp wakeLength
      cases head <;> cases wake₁ <;> cases wake₂ <;>
        simp [bcbcTail, bcbcNull, consumed_cons, produced_cons, strokeBCB, stroke₃,
          Stroke.letters, bcbcBody, tagOutput, nearyBody]

/-- The complete terminal history `F D (X (D Z)ⁿ F)*`. -/
def terminalHistory (depths : List Nat) : List (Stroke TagLetter 3) :=
  strokeCBC :: strokeBCB :: nullHistory depths

/-- Complete semantic grammar of the terminal `bcbc` role words. -/
theorem bcbc_terminal_match_iff (word : List NearyTile) :
    spell (nearyUpper 3) word ++ nearyMarker 3 =
        spell (nearyLower 3 bcbcBody) word ↔
      ∃ depths, word = tileHistory (terminalHistory depths) := by
  constructor
  · intro terminal
    obtain ⟨history, rfl⟩ :=
      tileHistory_of_terminal_match 3 bcbcBody (by decide) word terminal
    have nonempty : history ≠ [] := by
      intro empty
      subst history
      simp [spell, nearyMarker] at terminal
    obtain ⟨first, tail, rfl⟩ := List.exists_cons_of_ne_nil nonempty
    have semantic :=
      (terminal_match_tileHistory_iff 3 bcbcBody (by decide) first tail).mp terminal
    rcases first with ⟨head, wake, width⟩
    have wakeLength : wake.length = 2 := by omega
    obtain ⟨wake₁, wake₂, rfl⟩ := List.length_eq_two.mp wakeLength
    cases head <;> cases wake₁ <;> cases wake₂ <;>
      simp [consumed_cons, bcbcBody, nearyBody, Stroke.letters] at semantic
    obtain ⟨nullTail, tail_eq, null⟩ := (bcbcTail_iff tail).mp semantic
    obtain ⟨depths, null_eq⟩ := (bcbcNull_iff nullTail).mp null
    refine ⟨depths, ?_⟩
    simp [terminalHistory, strokeCBC, stroke₃, tail_eq, null_eq]
  · rintro ⟨depths, rfl⟩
    apply (terminal_match_tileHistory_iff 3 bcbcBody (by decide)
      strokeCBC (strokeBCB :: nullHistory depths)).mpr
    have null := (bcbcNull_iff (nullHistory depths)).mpr ⟨depths, rfl⟩
    simpa [strokeCBC, strokeBCB, stroke₃, Stroke.letters, consumed_cons, produced_cons,
      bcbcBody, tagOutput, nearyBody, bcbcNull, List.append_assoc] using null

/-! ## The singular affine recognizer reported for the fixed language -/

private abbrev recognizerParameters : AffineRecognizer.Parameters ℤ ℚ where
  cast := Int.castRingHom ℚ
  carryScale
    | .b => 5
    | .c => 7
  carryShift
    | .b => 385
    | .c => 534
  guardScale
    | .b => 1
    | .c => 1 / 6125
  guardShift
    | .b => 1 / 2
    | .c => -(29503 / 6125)
  toggleCenter := 2983

/-- Singular data matrices carrying one integer history coordinate and one transient guard. -/
def recognizerData : TagLetter → Matrix (Fin 3) (Fin 3) ℚ :=
  recognizerParameters.data

/-- The two data matrices and affine involution. -/
def recognizerGenerator : PairedControl → Matrix (Fin 3) (Fin 3) ℚ :=
  recognizerParameters.generator

/-- Boundary row selecting the transient guard. -/
def recognizerRow : Fin 3 → ℚ := AffineRecognizer.row

/-- Homogeneous state before the final boundary toggle. -/
def recognizerDelta : Fin 3 → ℚ := AffineRecognizer.delta

/-- Boundary column used by the reported same-zero representation. -/
def recognizerColumn : Fin 3 → ℚ := recognizerParameters.column

/-- Integer carry driven right-to-left by a raw paired-control word. -/
def recognizerCarry : List PairedControl → ℤ := recognizerParameters.carry

/-- First-coordinate guard driven by the same suffix carry. -/
def recognizerGuard : List PairedControl → ℚ := recognizerParameters.guard

/-- Exact affine state of every raw control word from `δ`. -/
theorem recognizerProduct_mulVec_delta (word : List PairedControl) :
    wordProduct recognizerGenerator word *ᵥ recognizerDelta =
      ![recognizerGuard word, recognizerCarry word, 1] :=
  recognizerParameters.wordProduct_mulVec_delta word

theorem recognizerColumn_eq_toggle_delta :
    recognizerColumn = recognizerGenerator .toggle *ᵥ recognizerDelta :=
  recognizerParameters.column_eq_toggle_delta

/-- Scalar coefficient of the explicit rational matrices. -/
def recognizerCoefficient (word : List PairedControl) : ℚ :=
  recognizerParameters.coefficient word

theorem recognizerCoefficient_eq_guard (word : List PairedControl) :
    recognizerCoefficient word = recognizerGuard (word ++ [.toggle]) :=
  recognizerParameters.coefficient_eq_guard word

@[simp] theorem recognizerData_det (letter : TagLetter) :
    (recognizerData letter).det = 0 :=
  recognizerParameters.data_det letter

@[simp] theorem recognizerToggle_det :
    (recognizerGenerator .toggle).det = -1 :=
  recognizerParameters.toggle_det

/-! ## Canonical terminal controls -/

/-- The raw four-control macro `h t u v` of a width-three stroke `huv`. -/
def strokeControl (stroke : Stroke TagLetter 3) : List PairedControl :=
  .data stroke.head :: .toggle :: stroke.wake.map .data

/-- Concatenate the control macros of a stroke history. -/
def historyControl : List (Stroke TagLetter 3) → List PairedControl
  | [] => []
  | stroke :: history => strokeControl stroke ++ historyControl history

@[simp] theorem historyControl_append (left right : List (Stroke TagLetter 3)) :
    historyControl (left ++ right) = historyControl left ++ historyControl right := by
  induction left with
  | nil => rfl
  | cons stroke history induction =>
      simp [historyControl, induction, List.append_assoc]

/-- A final toggle makes the canonical stroke controls decode in rule/erase/erase triples. -/
theorem suffixDecode_historyControl (history : List (Stroke TagLetter 3)) :
    suffixDecode (historyControl history ++ [.toggle]) = (.erase, tileHistory history) := by
  induction history with
  | nil => rfl
  | cons stroke history induction =>
      rcases stroke with ⟨head, wake, width⟩
      have wakeLength : wake.length = 2 := by omega
      obtain ⟨wake₁, wake₂, rfl⟩ := List.length_eq_two.mp wakeLength
      cases head <;> cases wake₁ <;> cases wake₂ <;>
        simp [historyControl, strokeControl, suffixDecode, tileHistory, strokeTiles,
          PairPhase.flip, PairPhase.tile, induction]

/-- Canonical control spelling of one complete terminal history. -/
def terminalControl (depths : List Nat) : List PairedControl :=
  historyControl (terminalHistory depths) ++ [.toggle]

theorem terminalControl_decode (depths : List Nat) :
    decodePairedWord (terminalControl depths) = tileHistory (terminalHistory depths) := by
  simpa [terminalControl, decodePairedWord] using
    congrArg Prod.snd (suffixDecode_historyControl (terminalHistory depths))

private def xControl : List PairedControl := strokeControl strokeBBB
private def dControl : List PairedControl := strokeControl strokeBCB
private def zControl : List PairedControl := strokeControl strokeCBB
private def fControl : List PairedControl := strokeControl strokeCBC

private theorem carry_x (tail : List PairedControl) :
    recognizerCarry (xControl ++ tail) = -125 * recognizerCarry tail + 3750 := by
  simp [xControl, strokeControl, strokeBBB, stroke₃, recognizerCarry]
  ring

private theorem carry_d (tail : List PairedControl) :
    recognizerCarry (dControl ++ tail) = -175 * recognizerCarry tail - 845 := by
  simp [dControl, strokeControl, strokeBCB, stroke₃, recognizerCarry]
  ring

private theorem carry_z (tail : List PairedControl) :
    recognizerCarry (zControl ++ tail) = -175 * recognizerCarry tail + 5245 := by
  simp [zControl, strokeControl, strokeCBB, stroke₃, recognizerCarry]
  ring

private theorem carry_f (tail : List PairedControl) :
    recognizerCarry (fControl ++ tail) = -245 * recognizerCarry tail + 30 := by
  simp [fControl, strokeControl, strokeCBC, stroke₃, recognizerCarry]
  ring

private theorem nestedCore_preserves_thirty (depth : Nat) (tail : List PairedControl)
    (tailCarry : recognizerCarry tail = 30) :
    recognizerCarry (historyControl (nestedCore depth) ++ tail) = 30 := by
  induction depth generalizing tail with
  | zero => simpa [nestedCore, historyControl] using tailCarry
  | succ depth induction =>
      rw [nestedCore, historyControl_append]
      simp only [historyControl, List.append_assoc]
      apply induction
      rw [show strokeControl strokeBCB = dControl by rfl,
        show strokeControl strokeCBB = zControl by rfl, carry_d, carry_z]
      simp only [List.nil_append]
      rw [tailCarry]
      norm_num

private theorem nullExcursion_preserves_zero (depth : Nat) (tail : List PairedControl)
    (tailCarry : recognizerCarry tail = 0) :
    recognizerCarry (historyControl (nullExcursion depth) ++ tail) = 0 := by
  rw [nullExcursion]
  change recognizerCarry
    (strokeControl strokeBBB ++ historyControl (nestedCore depth ++ [strokeCBC]) ++ tail) = 0
  rw [show strokeControl strokeBBB = xControl by rfl, List.append_assoc, carry_x]
  have afterCore :
      recognizerCarry
        (historyControl (nestedCore depth) ++ strokeControl strokeCBC ++ tail) = 30 := by
    have finishCarry : recognizerCarry (strokeControl strokeCBC ++ tail) = 30 := by
      rw [show strokeControl strokeCBC = fControl by rfl, carry_f, tailCarry]
      norm_num
    simpa [List.append_assoc] using
      nestedCore_preserves_thirty depth (strokeControl strokeCBC ++ tail) finishCarry
  have afterCore' :
      recognizerCarry (historyControl (nestedCore depth ++ [strokeCBC]) ++ tail) = 30 := by
    simpa [historyControl_append, historyControl, List.append_assoc] using afterCore
  rw [afterCore']
  norm_num

private theorem nullHistory_preserves_zero (depths : List Nat) (tail : List PairedControl)
    (tailCarry : recognizerCarry tail = 0) :
    recognizerCarry (historyControl (nullHistory depths) ++ tail) = 0 := by
  induction depths generalizing tail with
  | nil => simpa [nullHistory, historyControl] using tailCarry
  | cons depth depths induction =>
      rw [nullHistory, historyControl_append, List.append_assoc]
      apply nullExcursion_preserves_zero depth
      exact induction tail tailCarry

private theorem guard_f (tail : List PairedControl) :
    recognizerGuard (fControl ++ tail) =
      (-35 * recognizerCarry tail - 29575) / 6125 := by
  simp [fControl, strokeControl, strokeCBC, stroke₃, recognizerGuard, recognizerCarry]
  ring

/-- Every canonical terminal control is a zero of the reported matrices. The converse on every
raw control word is the finite reverse-carry certificate recorded in the accompanying audit. -/
theorem recognizerCoefficient_terminalControl (depths : List Nat) :
    recognizerCoefficient (terminalControl depths) = 0 := by
  rw [recognizerCoefficient_eq_guard]
  simp only [terminalControl, terminalHistory, historyControl, List.append_assoc]
  change recognizerGuard
    (fControl ++ (dControl ++
      (historyControl (nullHistory depths) ++ [.toggle, .toggle]))) = 0
  rw [guard_f]
  have nullCarry :
      recognizerCarry (historyControl (nullHistory depths) ++ [.toggle, .toggle]) = 0 := by
    apply nullHistory_preserves_zero
    norm_num [recognizerCarry]
  rw [carry_d, nullCarry]
  norm_num

theorem pairedCoefficient_terminalControl (depths : List Nat) :
    pairedCoefficient ℚ 3 bcbcBody (terminalControl depths) = 0 := by
  rw [pairedCoefficient_eq_sideCoefficient, terminalControl_decode,
    sideCoefficient_eq_zero_iff_terminal_match_rat]
  exact (bcbc_terminal_match_iff _).mpr ⟨depths, rfl⟩

end BranchingRecognizer

