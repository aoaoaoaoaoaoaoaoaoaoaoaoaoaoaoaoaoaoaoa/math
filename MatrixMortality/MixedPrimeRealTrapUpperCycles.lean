import MatrixMortality.MixedPrimeRealTrapReturn

/-!
# Guarded upper-run cycle core in the mixed-prime real trap

For every lower depth `n ≥ 7`, middle depth `2 ≤ m ≤ 6`, and upper-run length `r`,
this module constructs a guarded cycle with reverse-branch itinerary `L_n, U₀^r, U₁, M_m`
and shell schedule `0^(r+1), n, m−2`.

The arithmetic core records the four boundary mantissas and every intermediate upper mantissa.
Their interval bounds certify the reverse branches, the orbit identities close the cycle, and
five-adic prefix units keep the entire cycle inside the guarded shell.  Two-adic phase separation
and minimal-period consequences are proved in `MixedPrimeRealTrapUpperCyclePeriods`.
-/

namespace MatrixMortality.MixedPrimeDebt

open PadicValuation
open PeriodicShell

private local instance : Fact (Nat.Prime 5) := ⟨by norm_num⟩

/-- Five-power accumulated by an upper run of the displayed length. -/
def wallOddUpperRunFivePower (runLength : ℕ) : ℕ :=
  5 ^ runLength

/-- Three-power accumulated by an upper run of the displayed length. -/
def wallOddUpperRunThreePower (runLength : ℕ) : ℕ :=
  3 ^ runLength

/-- Positive power gap generated by the upper run. -/
def wallOddUpperRunPowerGap (runLength : ℕ) : ℕ :=
  wallOddUpperRunFivePower runLength - wallOddUpperRunThreePower runLength

private theorem wallOddUpperRunPowerGap_data (runLength : ℕ) :
    wallOddUpperRunPowerGap runLength +
        wallOddUpperRunThreePower runLength =
      wallOddUpperRunFivePower runLength := by
  apply Nat.sub_add_cancel
  exact Nat.pow_le_pow_left (by norm_num) _

/-! ## Exact family -/

/-- Difference between the large-depth three- and two-power scales. -/
def wallOddUpperFamilyLargePowerGap (depth : ℕ) : ℕ :=
  wallOddLargeThreePower depth - wallOddLargeTwoPower depth

/-- Difference between the middle-depth three- and two-power scales. -/
def wallOddUpperFamilyMiddlePowerGap (depth : ℕ) : ℕ :=
  wallOddMiddleThreePower depth - wallOddMiddleTwoPower depth

/-- Common odd half-denominator of the four boundary mantissas. -/
def wallOddUpperFamilyHalfDenominator
    (lowerDepth middleDepth runLength : ℕ) : ℕ :=
  123 * wallOddMiddleThreePower middleDepth *
      wallOddUpperRunFivePower runLength * wallOddLargeThreePower lowerDepth +
    2 * (wallOddMiddleThreePower middleDepth *
        wallOddUpperRunFivePower runLength *
          wallOddUpperFamilyLargePowerGap lowerDepth +
      wallOddLargeTwoPower lowerDepth *
        (wallOddMiddleThreePower middleDepth *
            wallOddUpperRunPowerGap runLength +
          wallOddUpperRunThreePower runLength *
            wallOddUpperFamilyMiddlePowerGap middleDepth))

/-- Numerator of the secondary-wall mantissa. -/
def wallOddUpperFamilyWallNumerator
    (lowerDepth middleDepth runLength : ℕ) : ℕ :=
  wallOddMiddleThreePower middleDepth *
    (225 * wallOddUpperRunFivePower runLength *
        wallOddLargeThreePower lowerDepth +
      wallOddLargeTwoPower lowerDepth *
        (16 * wallOddUpperRunThreePower runLength +
          25 * wallOddUpperRunPowerGap runLength))

/-- Large-depth-free factor of the first odd-phase numerator. -/
def wallOddUpperFamilyFirstOddCore
    (middleDepth runLength : ℕ) : ℕ :=
  wallOddMiddleThreePower middleDepth *
      (80 * wallOddUpperRunThreePower runLength +
        125 * wallOddUpperRunPowerGap runLength) +
    18 * wallOddMiddleTwoPower middleDepth *
      wallOddUpperRunThreePower runLength

/-- Numerator of the first odd-phase mantissa. -/
def wallOddUpperFamilyFirstOddNumerator
    (lowerDepth middleDepth runLength : ℕ) : ℕ :=
  wallOddLargeThreePower lowerDepth *
    wallOddUpperFamilyFirstOddCore middleDepth runLength

/-- Half-numerator of the terminal upper-phase mantissa. -/
def wallOddUpperFamilyLastUpperCore
    (lowerDepth middleDepth runLength : ℕ) : ℕ :=
  wallOddUpperRunFivePower runLength *
      wallOddLargeThreePower lowerDepth *
        (40 * wallOddMiddleThreePower middleDepth +
          9 * wallOddMiddleTwoPower middleDepth) +
    wallOddMiddleTwoPower middleDepth *
      wallOddLargeTwoPower lowerDepth *
        wallOddUpperRunPowerGap runLength

/-- Numerator of the terminal upper-phase mantissa. -/
def wallOddUpperFamilyLastUpperNumerator
    (lowerDepth middleDepth runLength : ℕ) : ℕ :=
  2 * wallOddUpperFamilyLastUpperCore lowerDepth middleDepth runLength

/-- Numerator of the second odd-phase mantissa. -/
def wallOddUpperFamilySecondOddNumerator
    (lowerDepth middleDepth runLength : ℕ) : ℕ :=
  15 * wallOddUpperRunFivePower runLength *
      wallOddLargeThreePower lowerDepth *
        (5 * wallOddMiddleThreePower middleDepth +
          3 * wallOddMiddleTwoPower middleDepth) +
    wallOddMiddleTwoPower middleDepth *
      wallOddLargeTwoPower lowerDepth *
        (2 * wallOddUpperRunThreePower runLength +
          5 * wallOddUpperRunPowerGap runLength)

/-- Normalized mantissa at the secondary-wall phase. -/
def wallOddUpperFamilyWallMantissa
    (lowerDepth middleDepth runLength : ℕ) : ℚ :=
  wallOddUpperFamilyWallNumerator lowerDepth middleDepth runLength /
    (2 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength)

/-- Normalized mantissa at the lower-depth odd phase. -/
def wallOddUpperFamilyFirstOddMantissa
    (lowerDepth middleDepth runLength : ℕ) : ℚ :=
  wallOddUpperFamilyFirstOddNumerator lowerDepth middleDepth runLength /
    wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength

/-- Normalized mantissa at the terminal upper phase. -/
def wallOddUpperFamilyLastUpperMantissa
    (lowerDepth middleDepth runLength : ℕ) : ℚ :=
  wallOddUpperFamilyLastUpperNumerator lowerDepth middleDepth runLength /
    wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength

/-- Normalized mantissa at the middle-entry odd phase. -/
def wallOddUpperFamilySecondOddMantissa
    (lowerDepth middleDepth runLength : ℕ) : ℚ :=
  wallOddUpperFamilySecondOddNumerator lowerDepth middleDepth runLength /
    wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength

private theorem wallOddUpperFamily_largeTwo_le_largeThree
    {depth : ℕ} (depth_lower : 7 ≤ depth) :
    wallOddLargeTwoPower depth ≤ wallOddLargeThreePower depth := by
  obtain ⟨offset, rfl⟩ := Nat.exists_eq_add_of_le depth_lower
  simp only [wallOddLargeTwoPower, wallOddLargeThreePower]
  have two_exponent : 7 + offset - 1 = 6 + offset := by omega
  have three_exponent : 7 + offset - 3 = 4 + offset := by omega
  rw [two_exponent, three_exponent]
  clear depth_lower two_exponent three_exponent
  induction offset with
  | zero => norm_num
  | succ offset induction =>
      rw [Nat.add_succ, Nat.add_succ, pow_succ, pow_succ]
      exact (Nat.mul_le_mul_right 2 induction).trans
        (Nat.mul_le_mul_left (3 ^ (4 + offset)) (by norm_num))

private theorem wallOddUpperFamily_middleTwo_le_middleThree (depth : ℕ) :
    wallOddMiddleTwoPower depth ≤ wallOddMiddleThreePower depth := by
  simp only [wallOddMiddleTwoPower, wallOddMiddleThreePower]
  exact Nat.pow_le_pow_left (by norm_num) _

private theorem wallOddUpperFamilyLargePowerGap_data
    {depth : ℕ} (depth_lower : 7 ≤ depth) :
    wallOddUpperFamilyLargePowerGap depth + wallOddLargeTwoPower depth =
      wallOddLargeThreePower depth :=
  Nat.sub_add_cancel
    (wallOddUpperFamily_largeTwo_le_largeThree depth_lower)

private theorem wallOddUpperFamilyMiddlePowerGap_data (depth : ℕ) :
    wallOddUpperFamilyMiddlePowerGap depth + wallOddMiddleTwoPower depth =
      wallOddMiddleThreePower depth :=
  Nat.sub_add_cancel (wallOddUpperFamily_middleTwo_le_middleThree depth)

private theorem wallOddUpperFamily_middle_bounds
    {depth : ℕ} (depth_lower : 2 ≤ depth) (depth_upper : depth ≤ 6) :
    4 * wallOddMiddleTwoPower depth < 9 * wallOddMiddleThreePower depth ∧
      10 * wallOddMiddleThreePower depth < 54 * wallOddMiddleTwoPower depth ∧
      5 * wallOddMiddleThreePower depth < 27 * wallOddMiddleTwoPower depth ∧
      9 * wallOddMiddleTwoPower depth ≤ 10 * wallOddMiddleThreePower depth ∧
      2 * wallOddMiddleTwoPower depth < 5 * wallOddMiddleThreePower depth := by
  interval_cases depth <;>
    norm_num [wallOddMiddleTwoPower, wallOddMiddleThreePower]

private theorem wallOddUpperFamily_halfDenominator_data
    {lowerDepth middleDepth runLength : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth) :
    2 * wallOddMiddleTwoPower middleDepth *
          wallOddUpperRunThreePower runLength * wallOddLargeTwoPower lowerDepth <
        125 * wallOddMiddleThreePower middleDepth *
          wallOddUpperRunFivePower runLength * wallOddLargeThreePower lowerDepth ∧
      wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength +
          2 * wallOddMiddleTwoPower middleDepth *
            wallOddUpperRunThreePower runLength * wallOddLargeTwoPower lowerDepth =
        125 * wallOddMiddleThreePower middleDepth *
          wallOddUpperRunFivePower runLength * wallOddLargeThreePower lowerDepth := by
  have q_le_p := wallOddUpperFamily_largeTwo_le_largeThree lowerDepth_lower
  have e_le_r := wallOddUpperFamily_middleTwo_le_middleThree middleDepth
  have g_le_f :
      wallOddUpperRunThreePower runLength ≤ wallOddUpperRunFivePower runLength := by
    exact Nat.pow_le_pow_left (by norm_num) _
  have product_le :
      wallOddMiddleTwoPower middleDepth *
          wallOddUpperRunThreePower runLength * wallOddLargeTwoPower lowerDepth ≤
        wallOddMiddleThreePower middleDepth *
          wallOddUpperRunFivePower runLength * wallOddLargeThreePower lowerDepth :=
    Nat.mul_le_mul (Nat.mul_le_mul e_le_r g_le_f) q_le_p
  have product_pos :
      0 < wallOddMiddleThreePower middleDepth *
        wallOddUpperRunFivePower runLength * wallOddLargeThreePower lowerDepth := by
    simp [wallOddMiddleThreePower, wallOddUpperRunFivePower,
      wallOddLargeThreePower]
  have strict :
      2 * wallOddMiddleTwoPower middleDepth *
          wallOddUpperRunThreePower runLength * wallOddLargeTwoPower lowerDepth <
        125 * wallOddMiddleThreePower middleDepth *
          wallOddUpperRunFivePower runLength * wallOddLargeThreePower lowerDepth := by
    nlinarith
  refine ⟨strict, ?_⟩
  have p_gap_eq := wallOddUpperFamilyLargePowerGap_data lowerDepth_lower
  have r_gap_eq := wallOddUpperFamilyMiddlePowerGap_data middleDepth
  have f_gap_eq := wallOddUpperRunPowerGap_data runLength
  simp only [wallOddUpperFamilyHalfDenominator]
  rw [← p_gap_eq, ← r_gap_eq, ← f_gap_eq]
  ring

private theorem wallOddUpperFamily_halfDenominator_pos
    (lowerDepth middleDepth runLength : ℕ) :
    0 < wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength := by
  have leading_pos :
      0 < 123 * wallOddMiddleThreePower middleDepth *
        wallOddUpperRunFivePower runLength * wallOddLargeThreePower lowerDepth := by
    simp [wallOddMiddleThreePower, wallOddUpperRunFivePower,
      wallOddLargeThreePower]
  simp only [wallOddUpperFamilyHalfDenominator]
  omega

private theorem wallOddUpperFamily_affine_identities
    {lowerDepth middleDepth runLength : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth) :
    5 * wallOddUpperFamilyWallNumerator lowerDepth middleDepth runLength =
        9 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength +
          wallOddLargeTwoPower lowerDepth *
            wallOddUpperFamilyFirstOddCore middleDepth runLength ∧
      2 * wallOddUpperRunThreePower runLength *
            wallOddUpperFamilyLastUpperCore lowerDepth middleDepth runLength +
          wallOddUpperRunPowerGap runLength *
            wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength =
        wallOddUpperRunFivePower runLength *
          wallOddUpperFamilyFirstOddNumerator lowerDepth middleDepth runLength ∧
      wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength +
          wallOddUpperFamilySecondOddNumerator lowerDepth middleDepth runLength =
        5 * wallOddUpperFamilyLastUpperCore lowerDepth middleDepth runLength ∧
      wallOddMiddleTwoPower middleDepth *
            wallOddUpperFamilyWallNumerator lowerDepth middleDepth runLength +
          3 * wallOddMiddleThreePower middleDepth *
            wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength =
        5 * wallOddMiddleThreePower middleDepth *
          wallOddUpperFamilySecondOddNumerator lowerDepth middleDepth runLength := by
  have p_gap_eq := wallOddUpperFamilyLargePowerGap_data lowerDepth_lower
  have r_gap_eq := wallOddUpperFamilyMiddlePowerGap_data middleDepth
  have f_gap_eq := wallOddUpperRunPowerGap_data runLength
  simp only [wallOddUpperFamilyWallNumerator,
    wallOddUpperFamilyHalfDenominator,
    wallOddUpperFamilyFirstOddCore,
    wallOddUpperFamilyFirstOddNumerator,
    wallOddUpperFamilyLastUpperCore,
    wallOddUpperFamilySecondOddNumerator]
  rw [← p_gap_eq, ← r_gap_eq, ← f_gap_eq]
  constructor
  · ring
  constructor
  · ring
  constructor <;> ring

set_option maxHeartbeats 800000 in
private theorem wallOddUpperFamily_bounds_nat
    {lowerDepth middleDepth runLength : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth)
    (middleDepth_lower : 2 ≤ middleDepth)
    (middleDepth_upper : middleDepth ≤ 6) :
    18 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength <
        10 * wallOddUpperFamilyWallNumerator lowerDepth middleDepth runLength ∧
      wallOddUpperFamilyWallNumerator lowerDepth middleDepth runLength <
        2 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength ∧
      2 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength <
        3 * wallOddUpperFamilyFirstOddNumerator lowerDepth middleDepth runLength ∧
      wallOddUpperFamilyFirstOddNumerator lowerDepth middleDepth runLength <
        wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength ∧
      2 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength <
        3 * wallOddUpperFamilyLastUpperNumerator lowerDepth middleDepth runLength ∧
      5 * wallOddUpperFamilyLastUpperNumerator lowerDepth middleDepth runLength <
        4 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength ∧
      2 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength <
        3 * wallOddUpperFamilySecondOddNumerator lowerDepth middleDepth runLength ∧
      wallOddUpperFamilySecondOddNumerator lowerDepth middleDepth runLength <
        wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength := by
  have identities := wallOddUpperFamily_affine_identities
    (middleDepth := middleDepth) (runLength := runLength) lowerDepth_lower
  have p_gap_eq := wallOddUpperFamilyLargePowerGap_data lowerDepth_lower
  have r_gap_eq := wallOddUpperFamilyMiddlePowerGap_data middleDepth
  have f_gap_eq := wallOddUpperRunPowerGap_data runLength
  have p_gap_eq_rat :
      (wallOddUpperFamilyLargePowerGap lowerDepth : ℚ) +
          wallOddLargeTwoPower lowerDepth =
        wallOddLargeThreePower lowerDepth := by
    exact_mod_cast p_gap_eq
  have r_gap_eq_rat :
      (wallOddUpperFamilyMiddlePowerGap middleDepth : ℚ) +
          wallOddMiddleTwoPower middleDepth =
        wallOddMiddleThreePower middleDepth := by
    exact_mod_cast r_gap_eq
  have f_gap_eq_rat :
      (wallOddUpperRunPowerGap runLength : ℚ) +
          wallOddUpperRunThreePower runLength =
        wallOddUpperRunFivePower runLength := by
    exact_mod_cast f_gap_eq
  have middle_bounds := wallOddUpperFamily_middle_bounds
    middleDepth_lower middleDepth_upper
  have p_gap_nonnegative : 0 ≤ wallOddUpperFamilyLargePowerGap lowerDepth := by
    omega
  have r_gap_nonnegative : 0 ≤ wallOddUpperFamilyMiddlePowerGap middleDepth := by
    omega
  have f_gap_nonnegative : 0 ≤ wallOddUpperRunPowerGap runLength := by omega
  have p_pos : 0 < wallOddLargeThreePower lowerDepth := by
    simp [wallOddLargeThreePower]
  have q_pos : 0 < wallOddLargeTwoPower lowerDepth := by
    simp [wallOddLargeTwoPower]
  have r_pos : 0 < wallOddMiddleThreePower middleDepth := by
    simp [wallOddMiddleThreePower]
  have e_pos : 0 < wallOddMiddleTwoPower middleDepth := by
    simp [wallOddMiddleTwoPower]
  have f_pos : 0 < wallOddUpperRunFivePower runLength := by
    simp [wallOddUpperRunFivePower]
  have g_pos : 0 < wallOddUpperRunThreePower runLength := by
    simp [wallOddUpperRunThreePower]
  have first_core_pos :
      0 < wallOddUpperFamilyFirstOddCore middleDepth runLength := by
    simp only [wallOddUpperFamilyFirstOddCore]
    positivity
  have wall_upper_gap :
      wallOddUpperFamilyWallNumerator lowerDepth middleDepth runLength +
          (25 * wallOddMiddleThreePower middleDepth *
              wallOddUpperRunFivePower runLength *
                wallOddUpperFamilyLargePowerGap lowerDepth +
            wallOddUpperRunThreePower runLength *
              wallOddLargeTwoPower lowerDepth *
                (5 * wallOddMiddleTwoPower middleDepth +
                  9 * wallOddUpperFamilyMiddlePowerGap middleDepth)) =
        2 * wallOddUpperFamilyHalfDenominator
          lowerDepth middleDepth runLength := by
    simp only [wallOddUpperFamilyWallNumerator,
      wallOddUpperFamilyHalfDenominator]
    rw [← p_gap_eq, ← r_gap_eq, ← f_gap_eq]
    ring
  have first_upper_gap :
      wallOddUpperFamilyFirstOddNumerator lowerDepth middleDepth runLength +
          wallOddUpperRunThreePower runLength *
            (9 * wallOddUpperFamilyLargePowerGap lowerDepth *
                (3 * wallOddMiddleTwoPower middleDepth +
                  5 * wallOddUpperFamilyMiddlePowerGap middleDepth) +
              5 * wallOddLargeTwoPower lowerDepth *
                (5 * wallOddMiddleTwoPower middleDepth +
                  9 * wallOddUpperFamilyMiddlePowerGap middleDepth)) =
        wallOddUpperFamilyHalfDenominator
          lowerDepth middleDepth runLength := by
    simp only [wallOddUpperFamilyFirstOddNumerator,
      wallOddUpperFamilyFirstOddCore,
      wallOddUpperFamilyHalfDenominator]
    rw [← p_gap_eq, ← r_gap_eq, ← f_gap_eq]
    ring
  have last_upper_gap :
      5 * wallOddUpperFamilyLastUpperCore lowerDepth middleDepth runLength +
          (5 * wallOddUpperRunFivePower runLength *
              wallOddUpperFamilyLargePowerGap lowerDepth *
                (wallOddMiddleTwoPower middleDepth +
                  10 * wallOddUpperFamilyMiddlePowerGap middleDepth) +
            wallOddLargeTwoPower lowerDepth *
              (50 * wallOddUpperRunFivePower runLength *
                  wallOddUpperFamilyMiddlePowerGap middleDepth +
                wallOddMiddleTwoPower middleDepth *
                  wallOddUpperRunThreePower runLength)) =
        2 * wallOddUpperFamilyHalfDenominator
          lowerDepth middleDepth runLength := by
    simp only [wallOddUpperFamilyLastUpperCore,
      wallOddUpperFamilyHalfDenominator]
    rw [← p_gap_eq, ← r_gap_eq, ← f_gap_eq]
    ring
  have wall_lower :
      18 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength <
        10 * wallOddUpperFamilyWallNumerator lowerDepth middleDepth runLength := by
    have positive :
        0 < 2 * wallOddLargeTwoPower lowerDepth *
          wallOddUpperFamilyFirstOddCore middleDepth runLength := by positivity
    nlinarith [identities.1]
  have wall_upper :
      wallOddUpperFamilyWallNumerator lowerDepth middleDepth runLength <
        2 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength := by
    have positive : 0 <
        25 * wallOddMiddleThreePower middleDepth *
            wallOddUpperRunFivePower runLength *
              wallOddUpperFamilyLargePowerGap lowerDepth +
          wallOddUpperRunThreePower runLength *
            wallOddLargeTwoPower lowerDepth *
              (5 * wallOddMiddleTwoPower middleDepth +
                9 * wallOddUpperFamilyMiddlePowerGap middleDepth) := by
      positivity
    nlinarith [wall_upper_gap]
  have first_lower :
      2 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength <
        3 * wallOddUpperFamilyFirstOddNumerator lowerDepth middleDepth runLength := by
    have middle_gap_rat :
        (0 : ℚ) < 54 * (wallOddMiddleTwoPower middleDepth : ℚ) -
          10 * (wallOddMiddleThreePower middleDepth : ℚ) := by
      apply sub_pos.mpr
      exact_mod_cast middle_bounds.2.1
    have gap_identity :
        (3 : ℚ) * wallOddUpperFamilyFirstOddNumerator
              lowerDepth middleDepth runLength -
            2 * wallOddUpperFamilyHalfDenominator
              lowerDepth middleDepth runLength =
          125 * wallOddMiddleThreePower middleDepth *
              wallOddLargeThreePower lowerDepth *
                wallOddUpperRunPowerGap runLength +
            wallOddUpperRunThreePower runLength *
              (wallOddLargeThreePower lowerDepth *
                  (54 * wallOddMiddleTwoPower middleDepth -
                    10 * wallOddMiddleThreePower middleDepth) +
                4 * wallOddMiddleTwoPower middleDepth *
                  wallOddLargeTwoPower lowerDepth) := by
      simp only [wallOddUpperFamilyFirstOddNumerator,
        wallOddUpperFamilyFirstOddCore,
        wallOddUpperFamilyHalfDenominator]
      push_cast
      rw [← p_gap_eq_rat, ← r_gap_eq_rat, ← f_gap_eq_rat]
      ring
    have positive : (0 : ℚ) <
        125 * wallOddMiddleThreePower middleDepth *
            wallOddLargeThreePower lowerDepth *
              wallOddUpperRunPowerGap runLength +
          wallOddUpperRunThreePower runLength *
            (wallOddLargeThreePower lowerDepth *
                (54 * wallOddMiddleTwoPower middleDepth -
                  10 * wallOddMiddleThreePower middleDepth) +
              4 * wallOddMiddleTwoPower middleDepth *
                wallOddLargeTwoPower lowerDepth) := by
      have second_pos : (0 : ℚ) <
          wallOddUpperRunThreePower runLength *
            (wallOddLargeThreePower lowerDepth *
                (54 * wallOddMiddleTwoPower middleDepth -
                  10 * wallOddMiddleThreePower middleDepth) +
              4 * wallOddMiddleTwoPower middleDepth *
                wallOddLargeTwoPower lowerDepth) := by positivity
      positivity
    exact_mod_cast (show
      (2 : ℚ) * wallOddUpperFamilyHalfDenominator
          lowerDepth middleDepth runLength <
        3 * wallOddUpperFamilyFirstOddNumerator
          lowerDepth middleDepth runLength by nlinarith)
  have first_upper :
      wallOddUpperFamilyFirstOddNumerator lowerDepth middleDepth runLength <
        wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength := by
    have positive : 0 < wallOddUpperRunThreePower runLength *
        (9 * wallOddUpperFamilyLargePowerGap lowerDepth *
            (3 * wallOddMiddleTwoPower middleDepth +
              5 * wallOddUpperFamilyMiddlePowerGap middleDepth) +
          5 * wallOddLargeTwoPower lowerDepth *
            (5 * wallOddMiddleTwoPower middleDepth +
              9 * wallOddUpperFamilyMiddlePowerGap middleDepth)) := by positivity
    nlinarith [first_upper_gap]
  have last_lower_core :
      wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength <
        3 * wallOddUpperFamilyLastUpperCore lowerDepth middleDepth runLength := by
    have middle_gap_rat :
        (0 : ℚ) < 27 * (wallOddMiddleTwoPower middleDepth : ℚ) -
          5 * (wallOddMiddleThreePower middleDepth : ℚ) := by
      apply sub_pos.mpr
      exact_mod_cast middle_bounds.2.2.1
    have gap_identity :
        (3 : ℚ) * wallOddUpperFamilyLastUpperCore
              lowerDepth middleDepth runLength -
            wallOddUpperFamilyHalfDenominator
              lowerDepth middleDepth runLength =
          wallOddUpperRunFivePower runLength *
              wallOddLargeThreePower lowerDepth *
                (27 * wallOddMiddleTwoPower middleDepth -
                  5 * wallOddMiddleThreePower middleDepth) +
            wallOddMiddleTwoPower middleDepth *
              wallOddLargeTwoPower lowerDepth *
                (2 * wallOddUpperRunThreePower runLength +
                  3 * wallOddUpperRunPowerGap runLength) := by
      simp only [wallOddUpperFamilyLastUpperCore,
        wallOddUpperFamilyHalfDenominator]
      push_cast
      rw [← p_gap_eq_rat, ← r_gap_eq_rat, ← f_gap_eq_rat]
      ring
    have positive : (0 : ℚ) <
        wallOddUpperRunFivePower runLength *
            wallOddLargeThreePower lowerDepth *
              (27 * wallOddMiddleTwoPower middleDepth -
                5 * wallOddMiddleThreePower middleDepth) +
          wallOddMiddleTwoPower middleDepth *
            wallOddLargeTwoPower lowerDepth *
              (2 * wallOddUpperRunThreePower runLength +
                3 * wallOddUpperRunPowerGap runLength) := by positivity
    exact_mod_cast (show
      (wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength : ℚ) <
        3 * wallOddUpperFamilyLastUpperCore lowerDepth middleDepth runLength by
          nlinarith)
  have last_upper_core :
      5 * wallOddUpperFamilyLastUpperCore lowerDepth middleDepth runLength <
        2 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength := by
    have positive : 0 <
        5 * wallOddUpperRunFivePower runLength *
            wallOddUpperFamilyLargePowerGap lowerDepth *
              (wallOddMiddleTwoPower middleDepth +
                10 * wallOddUpperFamilyMiddlePowerGap middleDepth) +
          wallOddLargeTwoPower lowerDepth *
            (50 * wallOddUpperRunFivePower runLength *
                wallOddUpperFamilyMiddlePowerGap middleDepth +
              wallOddMiddleTwoPower middleDepth *
                wallOddUpperRunThreePower runLength) := by
      have second_pos : 0 < wallOddLargeTwoPower lowerDepth *
          (50 * wallOddUpperRunFivePower runLength *
              wallOddUpperFamilyMiddlePowerGap middleDepth +
            wallOddMiddleTwoPower middleDepth *
              wallOddUpperRunThreePower runLength) := by positivity
      omega
    nlinarith [last_upper_gap]
  have last_lower :
      2 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength <
        3 * wallOddUpperFamilyLastUpperNumerator lowerDepth middleDepth runLength := by
    simp only [wallOddUpperFamilyLastUpperNumerator]
    omega
  have last_upper :
      5 * wallOddUpperFamilyLastUpperNumerator lowerDepth middleDepth runLength <
        4 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength := by
    simp only [wallOddUpperFamilyLastUpperNumerator]
    omega
  have second_lower :
      2 * wallOddUpperFamilyHalfDenominator lowerDepth middleDepth runLength <
        3 * wallOddUpperFamilySecondOddNumerator lowerDepth middleDepth runLength := by
    have relation := identities.2.2.1
    omega
  have second_upper :
