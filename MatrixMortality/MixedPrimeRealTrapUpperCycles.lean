  calc
    1 / 5 + 3 / 10 * (2 / 3) ^ middleDepth *
          ((wallOddMiddleThreePower middleDepth : ℚ) /
              (2 * wallOddMiddleTwoPower middleDepth) *
            (5 * wallOddUpperFamilySecondOddMantissa
