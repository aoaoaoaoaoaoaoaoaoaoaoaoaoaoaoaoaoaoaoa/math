    {lowerDepth middleDepth runLength : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth) :
    wallOddUpperFamilyUpperMantissa
        lowerDepth middleDepth runLength runLength =
      wallOddUpperFamilyLastUpperMantissa
        lowerDepth middleDepth runLength := by
  rw [wallOddUpperFamilyUpperMantissa,
    ← wallOddUpperRun_powerRatio runLength,
    wallOddUpperFamilyLastUpper_eq_iterate lowerDepth_lower]
  ring

private theorem wallOddUpperFamilyUpperMantissa_eq_from_last
    {lowerDepth middleDepth runLength index : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth) (index_le : index ≤ runLength) :
    wallOddUpperFamilyUpperMantissa lowerDepth middleDepth runLength index =
      1 - (3 / 5 : ℚ) ^ (runLength - index) *
        (1 - wallOddUpperFamilyLastUpperMantissa
          lowerDepth middleDepth runLength) := by
  have scale_identity :
      (3 / 5 : ℚ) ^ (runLength - index) *
          (5 / 3 : ℚ) ^ runLength =
        (5 / 3 : ℚ) ^ index := by
    obtain ⟨offset, rfl⟩ := Nat.exists_eq_add_of_le index_le
    simp only [Nat.add_sub_cancel_left, pow_add, div_pow]
    field_simp
  rw [wallOddUpperFamilyUpperMantissa,
    wallOddUpperFamilyLastUpper_eq_iterate lowerDepth_lower]
  rw [wallOddUpperRun_powerRatio]
  linear_combination
    (1 - wallOddUpperFamilyFirstOddMantissa
      lowerDepth middleDepth runLength) * scale_identity

theorem wallOddUpperFamilyUpperMantissa_normalized
    {lowerDepth middleDepth runLength index : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth)
    (middleDepth_lower : 2 ≤ middleDepth)
    (middleDepth_upper : middleDepth ≤ 6)
    (index_le : index ≤ runLength) :
    2 / 3 < wallOddUpperFamilyUpperMantissa
        lowerDepth middleDepth runLength index ∧
      wallOddUpperFamilyUpperMantissa
        lowerDepth middleDepth runLength index < 1 := by
  have last_bounds := wallOddUpperFamilyLastUpperMantissa_upperInterval
    (runLength := runLength) lowerDepth_lower middleDepth_lower middleDepth_upper
  have representation := wallOddUpperFamilyUpperMantissa_eq_from_last
    (middleDepth := middleDepth) lowerDepth_lower index_le
  have power_pos : 0 < (3 / 5 : ℚ) ^ (runLength - index) := by positivity
  have power_le : (3 / 5 : ℚ) ^ (runLength - index) ≤ 1 :=
    pow_le_one₀ (by norm_num) (by norm_num)
  rw [representation]
  constructor
  · have one_sub_last : 0 <
        1 - wallOddUpperFamilyLastUpperMantissa
          lowerDepth middleDepth runLength := by linarith
    have scaled_le :
        (3 / 5 : ℚ) ^ (runLength - index) *
            (1 - wallOddUpperFamilyLastUpperMantissa
              lowerDepth middleDepth runLength) ≤
          1 * (1 - wallOddUpperFamilyLastUpperMantissa
            lowerDepth middleDepth runLength) :=
      mul_le_mul_of_nonneg_right power_le one_sub_last.le
    linarith
  · have one_sub_last : 0 <
        1 - wallOddUpperFamilyLastUpperMantissa
          lowerDepth middleDepth runLength := by linarith
    exact sub_lt_self 1 (mul_pos power_pos one_sub_last)

theorem wallOddUpperFamilyUpperMantissa_above_fourFifths
    {lowerDepth middleDepth runLength index : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth)
    (middleDepth_lower : 2 ≤ middleDepth)
    (middleDepth_upper : middleDepth ≤ 6)
    (index_lt : index < runLength) :
    4 / 5 < wallOddUpperFamilyUpperMantissa
      lowerDepth middleDepth runLength index := by
  have last_bounds := wallOddUpperFamilyLastUpperMantissa_upperInterval
    (runLength := runLength) lowerDepth_lower middleDepth_lower middleDepth_upper
  have representation := wallOddUpperFamilyUpperMantissa_eq_from_last
    (middleDepth := middleDepth) lowerDepth_lower index_lt.le
  have exponent_pos : 0 < runLength - index := Nat.sub_pos_of_lt index_lt
  obtain ⟨offset, exponent_eq⟩ := Nat.exists_eq_succ_of_ne_zero exponent_pos.ne'
  have tail_power_le : (3 / 5 : ℚ) ^ offset ≤ 1 :=
    pow_le_one₀ (by norm_num) (by norm_num)
  have power_le : (3 / 5 : ℚ) ^ (runLength - index) ≤ 3 / 5 := by
    rw [exponent_eq, pow_succ]
    nlinarith [mul_le_mul_of_nonneg_right tail_power_le (by norm_num : (0 : ℚ) ≤ 3 / 5)]
  have one_sub_last :
      0 < 1 - wallOddUpperFamilyLastUpperMantissa
        lowerDepth middleDepth runLength := by linarith
  have last_gap :
      1 - wallOddUpperFamilyLastUpperMantissa
        lowerDepth middleDepth runLength < 1 / 3 := by linarith
  rw [representation]
  have scaled_lt :
      (3 / 5 : ℚ) ^ (runLength - index) *
          (1 - wallOddUpperFamilyLastUpperMantissa
            lowerDepth middleDepth runLength) <
        (3 / 5) * (1 / 3) := by
    calc
      _ ≤ (3 / 5) *
          (1 - wallOddUpperFamilyLastUpperMantissa
            lowerDepth middleDepth runLength) :=
        mul_le_mul_of_nonneg_right power_le one_sub_last.le
      _ < (3 / 5) * (1 / 3) :=
        mul_lt_mul_of_pos_left last_gap (by norm_num)
  norm_num at scaled_lt ⊢
  linarith

theorem realTrapBandPoint_wallOddUpperFamilyFirstOdd_eq_lower
    {lowerDepth middleDepth runLength : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth) :
    realTrapBandPoint lowerDepth
        (wallOddUpperFamilyFirstOddMantissa
          lowerDepth middleDepth runLength) =
      2 * wallOddUpperFamilyWallMantissa
        lowerDepth middleDepth runLength / 9 := by
  have scale_identity :
      (3 / 10 : ℚ) * (2 / 3) ^ lowerDepth *
          ((wallOddLargeThreePower lowerDepth : ℚ) /
            wallOddLargeTwoPower lowerDepth) =
        1 / 45 := by
    obtain ⟨offset, rfl⟩ := Nat.exists_eq_add_of_le lowerDepth_lower
    simp only [wallOddLargeThreePower, wallOddLargeTwoPower]
    have three_exponent : 7 + offset - 3 = 4 + offset := by omega
    have two_exponent : 7 + offset - 1 = 6 + offset := by omega
    rw [three_exponent, two_exponent, pow_add, pow_add, pow_add, div_pow]
    norm_num
    simp only [div_pow]
    field_simp
    ring
  rw [wallOddUpperFamilyFirstOdd_eq_lower lowerDepth_lower]
  simp only [realTrapBandPoint]
  calc
    1 / 5 + 3 / 10 * (2 / 3) ^ lowerDepth *
          ((wallOddLargeThreePower lowerDepth : ℚ) /
            wallOddLargeTwoPower lowerDepth *
              (10 * wallOddUpperFamilyWallMantissa
                lowerDepth middleDepth runLength - 9)) =
        1 / 5 +
          (3 / 10 * (2 / 3) ^ lowerDepth *
            ((wallOddLargeThreePower lowerDepth : ℚ) /
              wallOddLargeTwoPower lowerDepth)) *
                (10 * wallOddUpperFamilyWallMantissa
                  lowerDepth middleDepth runLength - 9) := by ring
    _ = 1 / 5 + 1 / 45 *
          (10 * wallOddUpperFamilyWallMantissa
            lowerDepth middleDepth runLength - 9) := by rw [scale_identity]
    _ = 2 * wallOddUpperFamilyWallMantissa
          lowerDepth middleDepth runLength / 9 := by ring

