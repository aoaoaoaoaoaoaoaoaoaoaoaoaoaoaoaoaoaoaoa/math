                  lowerDepth middleDepth runLength - 3) := by ring
    _ = 1 / 5 + 1 / 15 *
          (5 * wallOddUpperFamilySecondOddMantissa
            lowerDepth middleDepth runLength - 3) := by rw [scale_identity]
    _ = wallOddUpperFamilySecondOddMantissa
          lowerDepth middleDepth runLength / 3 := by ring

theorem shellRun_replicate_zero (count : ℕ) (state : ℚ) :
    shellRun (List.replicate count 0) state =
      1 / 2 + (3 / 5 : ℚ) ^ count * (state - 1 / 2) := by
  induction count generalizing state with
  | zero =>
      change state = 1 / 2 + (3 / 5 : ℚ) ^ 0 * (state - 1 / 2)
      norm_num
  | succ count induction =>
      rw [List.replicate_succ, shellRun_cons, induction]
      simp only [shellStep, pow_zero, mul_one, pow_succ]
      ring

/-- Chronological shell schedule of the guarded upper-run cycle. -/
def wallOddUpperFamilySchedule
    (lowerDepth middleDepth runLength : ℕ) : List ℕ :=
  List.replicate (runLength + 1) 0 ++ [lowerDepth, middleDepth - 2]

theorem wallOddUpperFamily_zeroPrefix
    {lowerDepth middleDepth runLength : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth)
    (middleDepth_lower : 2 ≤ middleDepth) :
    shellRun (List.replicate (runLength + 1) 0)
        (realTrapBandPoint middleDepth
          (wallOddUpperFamilyWallMantissa
            lowerDepth middleDepth runLength)) =
      wallOddUpperFamilyFirstOddMantissa
        lowerDepth middleDepth runLength / 2 := by
  have inverse_power :
      (3 / 5 : ℚ) ^ runLength * (5 / 3 : ℚ) ^ runLength = 1 := by
    rw [← mul_pow]
    norm_num
  rw [shellRun_replicate_zero,
    realTrapBandPoint_wallOddUpperFamilyWall_eq_middle
      lowerDepth_lower middleDepth_lower,
    wallOddUpperFamilySecondOdd_eq_upper lowerDepth_lower,
    wallOddUpperFamilyLastUpper_eq_iterate lowerDepth_lower,
    wallOddUpperRun_powerRatio]
  rw [pow_succ]
  ring_nf at inverse_power ⊢
  have scaled_inverse :
      wallOddUpperFamilyFirstOddMantissa
            lowerDepth middleDepth runLength *
          (3 / 5 : ℚ) ^ runLength * (5 / 3 : ℚ) ^ runLength =
        wallOddUpperFamilyFirstOddMantissa
          lowerDepth middleDepth runLength := by
    calc
      _ = wallOddUpperFamilyFirstOddMantissa
            lowerDepth middleDepth runLength *
          ((3 / 5 : ℚ) ^ runLength * (5 / 3 : ℚ) ^ runLength) := by ring
      _ = _ := by rw [inverse_power]; ring
  nlinarith [inverse_power, scaled_inverse]

theorem wallOddUpperFamily_cycle
    {lowerDepth middleDepth runLength : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth)
    (middleDepth_lower : 2 ≤ middleDepth) :
    shellRun (wallOddUpperFamilySchedule
        lowerDepth middleDepth runLength)
        (realTrapBandPoint middleDepth
          (wallOddUpperFamilyWallMantissa
            lowerDepth middleDepth runLength)) =
      realTrapBandPoint middleDepth
        (wallOddUpperFamilyWallMantissa
          lowerDepth middleDepth runLength) := by
  rw [wallOddUpperFamilySchedule, shellRun_append,
    wallOddUpperFamily_zeroPrefix lowerDepth_lower middleDepth_lower,
    shellRun_cons, shellStep_upperPredecessor,
    shellRun_cons,
    realTrapBandPoint_wallOddUpperFamilyFirstOdd_eq_lower lowerDepth_lower]
  have closing := shellStep_lowerPredecessor (middleDepth - 2)
    (wallOddUpperFamilyWallMantissa lowerDepth middleDepth runLength)
  rw [Nat.sub_add_cancel middleDepth_lower] at closing
  exact closing

theorem wallOddUpperFamily_middleEntryStep
    {lowerDepth middleDepth runLength : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth)
    (middleDepth_lower : 2 ≤ middleDepth) :
    shellStep 0
        (realTrapBandPoint middleDepth
          (wallOddUpperFamilyWallMantissa
            lowerDepth middleDepth runLength)) =
      realTrapBandPoint 1
        (wallOddUpperFamilySecondOddMantissa
          lowerDepth middleDepth runLength) := by
  rw [realTrapBandPoint_wallOddUpperFamilyWall_eq_middle
    lowerDepth_lower middleDepth_lower]
  simpa using shellStep_middlePredecessor 0
    (wallOddUpperFamilySecondOddMantissa
      lowerDepth middleDepth runLength)

theorem wallOddUpperFamily_upperStep
    (lowerDepth middleDepth runLength index : ℕ) :
    shellStep 0
        (realTrapBandPoint 0
          (wallOddUpperFamilyUpperMantissa
            lowerDepth middleDepth runLength (index + 1))) =
      realTrapBandPoint 0
        (wallOddUpperFamilyUpperMantissa
          lowerDepth middleDepth runLength index) := by
  rw [realTrapBandPoint_wallOddUpperFamilyUpper_succ_eq_upper]
  simpa using shellStep_upperPredecessor 0
    (wallOddUpperFamilyUpperMantissa
      lowerDepth middleDepth runLength index)

theorem wallOddUpperFamily_lowerClosingStep
    {lowerDepth middleDepth runLength : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth)
    (middleDepth_lower : 2 ≤ middleDepth) :
    shellStep (middleDepth - 2)
        (realTrapBandPoint lowerDepth
          (wallOddUpperFamilyFirstOddMantissa
            lowerDepth middleDepth runLength)) =
      realTrapBandPoint middleDepth
        (wallOddUpperFamilyWallMantissa
          lowerDepth middleDepth runLength) := by
  rw [realTrapBandPoint_wallOddUpperFamilyFirstOdd_eq_lower lowerDepth_lower]
  have closing := shellStep_lowerPredecessor (middleDepth - 2)
    (wallOddUpperFamilyWallMantissa lowerDepth middleDepth runLength)
  rw [Nat.sub_add_cancel middleDepth_lower] at closing
  exact closing

private theorem shellRun_fixed_fiveUnit
    {waits : List ℕ} (waits_ne : waits ≠ []) {state : ℚ}
    (fixed : shellRun waits state = state) :
    IsUnit 5 state := by
  have periodic_fixed :
      shellRun waits (shellPeriodicPoint waits) = shellPeriodicPoint waits :=
    (shellPeriodicCycle waits_ne).2.1
  have length_ne : waits.length ≠ ([] : List ℕ).length := by
    have length_positive : 0 < waits.length := List.length_pos_of_ne_nil waits_ne
    simp only [List.length_nil]
    omega
  have slope_ne : shellSlope waits ≠ 1 := by
    have unequal := shellSlope_ne_of_length_ne length_ne
    simpa [shellSlope] using unequal
  have displacement :=
    shellRun_sub_shellRun waits state (shellPeriodicPoint waits)
  rw [fixed, periodic_fixed] at displacement
  have factor_ne : 1 - shellSlope waits ≠ 0 :=
    sub_ne_zero.mpr slope_ne.symm
  have state_eq : state = shellPeriodicPoint waits := by
    apply sub_eq_zero.mp
    apply (mul_eq_zero.mp ?_).resolve_left factor_ne
    nlinarith
  rw [state_eq]
  exact (shellPeriodicCycle waits_ne).1

theorem wallOddUpperFamily_shellPrefixesUnit
    {lowerDepth middleDepth runLength : ℕ}
    (lowerDepth_lower : 7 ≤ lowerDepth)
    (middleDepth_lower : 2 ≤ middleDepth) :
    ∀ front back,
      wallOddUpperFamilySchedule lowerDepth middleDepth runLength =
          front ++ back →
        IsUnit 5
          (shellRun front
            (realTrapBandPoint middleDepth
              (wallOddUpperFamilyWallMantissa
                lowerDepth middleDepth runLength))) := by
  let schedule := wallOddUpperFamilySchedule
    lowerDepth middleDepth runLength
  let state := realTrapBandPoint middleDepth
    (wallOddUpperFamilyWallMantissa lowerDepth middleDepth runLength)
  have schedule_ne : schedule ≠ [] := by
    simp [schedule, wallOddUpperFamilySchedule]
  have fixed : shellRun schedule state = state :=
    wallOddUpperFamily_cycle lowerDepth_lower middleDepth_lower
  apply (shellPrefixesUnit_iff schedule state).2
  rw [fixed]
  exact shellRun_fixed_fiveUnit schedule_ne fixed

