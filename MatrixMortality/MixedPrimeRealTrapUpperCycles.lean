/-- Mantissa at one indexed phase of the zero-wait upper run. -/
def wallOddUpperFamilyUpperMantissa
    (lowerDepth middleDepth runLength index : ℕ) : ℚ :=
  1 - (5 / 3 : ℚ) ^ index *
    (1 - wallOddUpperFamilyFirstOddMantissa
      lowerDepth middleDepth runLength)

theorem wallOddUpperFamilyUpperMantissa_zero
    (lowerDepth middleDepth runLength : ℕ) :
    wallOddUpperFamilyUpperMantissa
      lowerDepth middleDepth runLength 0 =
        wallOddUpperFamilyFirstOddMantissa
          lowerDepth middleDepth runLength := by
  simp [wallOddUpperFamilyUpperMantissa]

theorem wallOddUpperFamilyUpperMantissa_succ
    (lowerDepth middleDepth runLength index : ℕ) :
    wallOddUpperFamilyUpperMantissa
        lowerDepth middleDepth runLength (index + 1) =
      (5 * wallOddUpperFamilyUpperMantissa
        lowerDepth middleDepth runLength index - 2) / 3 := by
  simp only [wallOddUpperFamilyUpperMantissa, pow_add]
  norm_num
  ring

private theorem wallOddUpperRun_powerRatio (runLength : ℕ) :
    (wallOddUpperRunFivePower runLength : ℚ) /
        wallOddUpperRunThreePower runLength =
      (5 / 3 : ℚ) ^ runLength := by
  simp only [wallOddUpperRunFivePower, wallOddUpperRunThreePower,
