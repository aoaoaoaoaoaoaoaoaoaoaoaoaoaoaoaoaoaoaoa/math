import MatrixMortality.SwappedSetterFringeLanguage
import Mathlib.Tactic

/-!
# Block-boundary inverse rigidity

The lower fringe language is generated by the binary blocks `0` and `110`.  Two equally long
suffixes ending at block boundaries cannot be modular inverses in the form required by the
swapped setter, except for the two terminal zero runs.
-/

namespace MatrixMortality.SwappedSetterFringe

/-- A word ending at a fringe-block boundary.  It may start at a block boundary or after the
first bit of `110`; these are the only two possible cuts. -/
def BoundarySuffix (word : List Bool) : Prop :=
  (∃ phases, word = spell fringeBlock phases) ∨
    ∃ phases, word = [true, false] ++ spell fringeBlock phases

/-- Fixed-width block-boundary suffix. -/
def BlockBoundarySuffix (width : Nat) (word : List Bool) : Prop :=
  word.length = width ∧ BoundarySuffix word

private theorem spell_fringeBlock_ne_nil {phases : List Bool} (phases_ne : phases ≠ []) :
    spell fringeBlock phases ≠ [] := by
  intro spell_empty
  rw [spell, List.flatMap_eq_nil_iff] at spell_empty
  obtain ⟨phase, phase_mem⟩ := List.exists_mem_of_ne_nil phases phases_ne
  have block_empty := spell_empty phase phase_mem
  cases phase <;> simp [fringeBlock] at block_empty

private theorem spell_fringeBlock_eq_nil_iff (phases : List Bool) :
    spell fringeBlock phases = [] ↔ phases = [] := by
  constructor
  · intro spell_empty
    by_contra phases_ne
    exact spell_fringeBlock_ne_nil phases_ne spell_empty
  · rintro rfl
    rfl

/-- The explicit two-cut grammar is exactly the suffix language of complete block spellings. -/
theorem boundarySuffix_iff_suffix_spell (word : List Bool) :
    BoundarySuffix word ↔ ∃ phases, word <:+ spell fringeBlock phases := by
  constructor
  · rintro (⟨phases, rfl⟩ | ⟨phases, rfl⟩)
    · exact ⟨phases, List.suffix_refl _⟩
    · refine ⟨true :: phases, ?_⟩
      change [true, false] ++ spell fringeBlock phases <:+
        true :: ([true, false] ++ spell fringeBlock phases)
      exact List.suffix_cons _ _
  · rintro ⟨phases, suffix⟩
    induction phases with
    | nil =>
        have word_empty : word = [] :=
          List.suffix_nil.mp (by simpa [spell] using suffix)
        exact Or.inl ⟨[], word_empty⟩
    | cons phase phases induction =>
        cases phase with
        | false =>
            change word <:+ false :: spell fringeBlock phases at suffix
            rcases List.suffix_cons_iff.mp suffix with word_eq | suffix_tail
            · exact Or.inl ⟨false :: phases, word_eq⟩
            · exact induction suffix_tail
        | true =>
            change word <:+ true :: true :: false :: spell fringeBlock phases at suffix
            rcases List.suffix_cons_iff.mp suffix with word_eq | suffix₁
            · exact Or.inl ⟨true :: phases, word_eq⟩
            · rcases List.suffix_cons_iff.mp suffix₁ with word_eq | suffix₂
              · exact Or.inr ⟨phases, word_eq⟩
              · rcases List.suffix_cons_iff.mp suffix₂ with word_eq | suffix_tail
                · exact Or.inl ⟨false :: phases, word_eq⟩
                · exact induction suffix_tail

private theorem BoundarySuffix.tail {head : Bool} {tail : List Bool}
    (suffix : BoundarySuffix (head :: tail)) : BoundarySuffix tail := by
  rw [boundarySuffix_iff_suffix_spell] at suffix ⊢
  obtain ⟨phases, word_suffix⟩ := suffix
  exact ⟨phases, (List.suffix_cons head tail).trans word_suffix⟩

private theorem BoundarySuffix.not_false_true_false_prefix (tail : List Bool) :
    ¬BoundarySuffix (false :: true :: false :: tail) := by
  intro suffix
  rcases suffix with ⟨phases, word_eq⟩ | ⟨phases, word_eq⟩
  · cases phases with
    | nil => simp [spell] at word_eq
    | cons phase phases =>
        cases phase with
        | true => simp [spell, fringeBlock] at word_eq
        | false =>
            simp only [spell, fringeBlock, List.flatMap_cons,
              List.singleton_append, List.cons.injEq, true_and] at word_eq
            cases phases with
            | nil => simp at word_eq
            | cons phase phases => cases phase <;> simp [fringeBlock] at word_eq
  · simp at word_eq

private theorem swappedCode_one_le {word : List Bool} (word_ne : word ≠ []) :
    1 ≤ swappedCode word := by
  cases word with
  | nil => exact False.elim (word_ne rfl)
  | cons head tail =>
      rw [swappedCode, List.map_cons, ternaryCode_cons]
      have power_pos : 0 < 3 ^ tail.length := pow_pos (by omega) tail.length
      cases head <;> simp [ternaryDigit] <;> omega

private theorem swappedCode_cons (head : Bool) (tail : List Bool) :
    swappedCode (head :: tail) =
      3 ^ tail.length * ternaryDigit (!head) + swappedCode tail := by
  simp [swappedCode, ternaryCode_cons]

private theorem swappedCode_replicate_false (length : Nat) :
    swappedCode (List.replicate length false) + 1 = 3 ^ length := by
  induction length with
  | zero => rfl
  | succ length induction =>
      rw [List.replicate_succ, swappedCode_cons, List.length_replicate]
      simp only [Bool.not_false, ternaryDigit, pow_succ]
      omega

private theorem swappedCode_true_false_run (length : Nat) :
    swappedCode (true :: List.replicate length false) + 1 = 2 * 3 ^ length := by
  rw [swappedCode_cons, List.length_replicate]
  simp only [Bool.not_true, ternaryDigit]
  have false_code := swappedCode_replicate_false length
  omega

private theorem swappedCode_false_false_run (length : Nat) :
    swappedCode (false :: List.replicate length false) + 1 = 3 * 3 ^ length := by
  rw [← List.replicate_succ]
  have code := swappedCode_replicate_false (length + 1)
  rw [pow_succ] at code
  omega

private theorem swappedCode_cons_mod_tail {width : Nat} (head : Bool) (tail : List Bool)
    (tail_length : tail.length = width) :
    swappedCode (head :: tail) ≡ swappedCode tail [MOD 3 ^ width] := by
  rw [swappedCode_cons, tail_length]
  exact Nat.ModEq.modulus_mul_add

private theorem shiftedSwappedCode_cons_mod_tail {width : Nat} (head : Bool)
    (tail : List Bool) (tail_length : tail.length = width) (tail_ne : tail ≠ []) :
    swappedCode (head :: tail) - 1 ≡ swappedCode tail - 1 [MOD 3 ^ width] := by
  have code_mod := swappedCode_cons_mod_tail head tail tail_length
  have full_one_le : 1 ≤ swappedCode (head :: tail) := swappedCode_one_le (by simp)
  have tail_one_le : 1 ≤ swappedCode tail := swappedCode_one_le tail_ne
  exact Nat.ModEq.sub full_one_le tail_one_le code_mod (Nat.ModEq.refl 1)

private theorem inverseRelation_tail {width : Nat} {xHead yHead : Bool}
    {xTail yTail : List Bool} (tail_pos : 0 < width)
    (x_length : xTail.length = width) (y_length : yTail.length = width)
    (relation :
      (swappedCode (xHead :: xTail) - 1) * swappedCode (yHead :: yTail) ≡ 2
        [MOD 3 ^ (width + 1)]) :
    (swappedCode xTail - 1) * swappedCode yTail ≡ 2 [MOD 3 ^ width] := by
  have x_ne : xTail ≠ [] := by
    intro tail_empty
    subst xTail
    simp at x_length
    omega
  have y_ne : yTail ≠ [] := by
    intro tail_empty
    subst yTail
    simp at y_length
    omega
  have x_mod := shiftedSwappedCode_cons_mod_tail xHead xTail x_length x_ne
  have y_mod := swappedCode_cons_mod_tail yHead yTail y_length
  have product_mod := x_mod.mul y_mod
  have power_dvd : 3 ^ width ∣ 3 ^ (width + 1) := pow_dvd_pow 3 (by omega)
  exact product_mod.symm.trans (relation.of_dvd power_dvd)

private theorem product_modEq_two_iff_dvd {factor scale product carry : Nat}
    (scale_pos : 0 < scale) (product_eq : product = 2 + scale * carry) :
    product ≡ 2 [MOD factor * scale] ↔ factor ∣ carry := by
  have two_le_product : 2 ≤ product := by omega
  rw [Nat.ModEq.comm, Nat.modEq_iff_dvd' two_le_product, product_eq,
    Nat.add_sub_cancel_left, Nat.mul_comm factor scale]
  exact Nat.mul_dvd_mul_iff_left scale_pos

private theorem zeroTail_heads_eq {width : Nat} (width_pos : 0 < width)
    (xHead yHead : Bool)
    (relation :
      (swappedCode (xHead :: List.replicate width false) - 1) *
          swappedCode (yHead :: List.replicate width false) ≡ 2
        [MOD 3 ^ (width + 1)]) :
    xHead = yHead := by
  let scale := 3 ^ width
  have scale_three : 3 ≤ scale := by
    change 3 ^ 1 ≤ 3 ^ width
    exact Nat.pow_le_pow_right (by omega) width_pos
  let offset := scale - 3
  have scale_eq : scale = offset + 3 := by
    dsimp [offset]
    omega
  have modulus_eq : 3 ^ (width + 1) = 3 * scale := by
    rw [pow_succ]
    simp [scale, Nat.mul_comm]
  cases xHead <;> cases yHead
  · rfl
  · have x_code := swappedCode_false_false_run width
    have y_code := swappedCode_true_false_run width
    have x_shift :
        swappedCode (false :: List.replicate width false) - 1 = 3 * offset + 7 := by
      change swappedCode (false :: List.replicate width false) + 1 = 3 * scale at x_code
      rw [scale_eq] at x_code
      omega
    have y_value :
        swappedCode (true :: List.replicate width false) = 2 * offset + 5 := by
      change swappedCode (true :: List.replicate width false) + 1 = 2 * scale at y_code
      rw [scale_eq] at y_code
      omega
    have product_eq :
        (swappedCode (false :: List.replicate width false) - 1) *
            swappedCode (true :: List.replicate width false) =
          2 + scale * (6 * offset + 11) := by
      rw [x_shift, y_value, scale_eq]
      ring
    have three_dvd : 3 ∣ 6 * offset + 11 :=
      (product_modEq_two_iff_dvd (by positivity : 0 < scale) product_eq).mp <| by
        simpa [modulus_eq] using relation
    obtain ⟨quotient, quotient_eq⟩ := three_dvd
    omega
  · have x_code := swappedCode_true_false_run width
    have y_code := swappedCode_false_false_run width
    have x_shift :
        swappedCode (true :: List.replicate width false) - 1 = 2 * offset + 4 := by
      change swappedCode (true :: List.replicate width false) + 1 = 2 * scale at x_code
      rw [scale_eq] at x_code
      omega
    have y_value :
        swappedCode (false :: List.replicate width false) = 3 * offset + 8 := by
      change swappedCode (false :: List.replicate width false) + 1 = 3 * scale at y_code
      rw [scale_eq] at y_code
      omega
    have product_eq :
        (swappedCode (true :: List.replicate width false) - 1) *
            swappedCode (false :: List.replicate width false) =
          2 + scale * (6 * offset + 10) := by
      rw [x_shift, y_value, scale_eq]
      ring
    have three_dvd : 3 ∣ 6 * offset + 10 :=
      (product_modEq_two_iff_dvd (by positivity : 0 < scale) product_eq).mp <| by
        simpa [modulus_eq] using relation
    obtain ⟨quotient, quotient_eq⟩ := three_dvd
    omega
  · rfl

private theorem oneTail_relation_false {width : Nat} (width_large : 3 ≤ width)
    (xHead yHead : Bool)
    (x_suffix :
      BoundarySuffix (xHead :: true :: List.replicate (width - 1) false))
    (relation :
      (swappedCode (xHead :: true :: List.replicate (width - 1) false) - 1) *
          swappedCode (yHead :: true :: List.replicate (width - 1) false) ≡ 2
        [MOD 3 ^ (width + 1)]) : False := by
  let scale := 3 ^ (width - 3)
  have scale_pos : 0 < scale := by positivity
  let offset := scale - 1
  have scale_eq : scale = offset + 1 := by
    dsimp [offset]
    omega
  have tail_power : 3 ^ (width - 1) = 9 * scale := by
    have exponent_eq : width - 1 = 2 + (width - 3) := by omega
    rw [exponent_eq, pow_add]
    norm_num [scale]
  have head_power : 3 ^ width = 27 * scale := by
    have exponent_eq : width = 3 + (width - 3) := by omega
    rw [exponent_eq, pow_add]
    norm_num [scale]
  have modulus_eq : 3 ^ (width + 1) = 81 * scale := by
    have exponent_eq : width + 1 = 4 + (width - 3) := by omega
    rw [exponent_eq, pow_add]
    norm_num [scale]
  have tail_code := swappedCode_true_false_run (width - 1)
  have false_code :
      swappedCode (false :: true :: List.replicate (width - 1) false) + 1 =
        72 * scale := by
    rw [swappedCode_cons]
    simp only [List.length_cons, List.length_replicate, Bool.not_false, ternaryDigit]
    rw [show (width - 1) + 1 = width by omega, head_power]
    rw [tail_power] at tail_code
    omega
  have true_code :
      swappedCode (true :: true :: List.replicate (width - 1) false) + 1 =
        45 * scale := by
    rw [swappedCode_cons]
    simp only [List.length_cons, List.length_replicate, Bool.not_true, ternaryDigit]
    rw [show (width - 1) + 1 = width by omega, head_power]
    rw [tail_power] at tail_code
    omega
  cases xHead <;> cases yHead
  · have x_shift :
        swappedCode (false :: true :: List.replicate (width - 1) false) - 1 =
          72 * offset + 70 := by
      rw [scale_eq] at false_code
      omega
    have y_value :
        swappedCode (false :: true :: List.replicate (width - 1) false) =
          72 * offset + 71 := by
      rw [scale_eq] at false_code
      omega
    have product_eq :
        (swappedCode (false :: true :: List.replicate (width - 1) false) - 1) *
            swappedCode (false :: true :: List.replicate (width - 1) false) =
          2 + scale * (5184 * offset + 4968) := by
      rw [x_shift, y_value, scale_eq]
      ring
    have factor_dvd : 81 ∣ 5184 * offset + 4968 :=
      (product_modEq_two_iff_dvd scale_pos product_eq).mp <| by
        simpa [modulus_eq] using relation
    obtain ⟨quotient, quotient_eq⟩ := factor_dvd
    omega
  · have forbidden :
        BoundarySuffix (false :: true :: false :: List.replicate (width - 2) false) := by
      have replicate_eq :
          List.replicate (width - 1) false =
            false :: List.replicate (width - 2) false := by
        rw [show width - 1 = (width - 2) + 1 by omega, List.replicate_succ]
      simpa only [replicate_eq] using x_suffix
    exact BoundarySuffix.not_false_true_false_prefix _ forbidden
  · have x_shift :
        swappedCode (true :: true :: List.replicate (width - 1) false) - 1 =
          45 * offset + 43 := by
      rw [scale_eq] at true_code
      omega
    have y_value :
        swappedCode (false :: true :: List.replicate (width - 1) false) =
          72 * offset + 71 := by
      rw [scale_eq] at false_code
      omega
    have product_eq :
        (swappedCode (true :: true :: List.replicate (width - 1) false) - 1) *
            swappedCode (false :: true :: List.replicate (width - 1) false) =
          2 + scale * (3240 * offset + 3051) := by
      rw [x_shift, y_value, scale_eq]
      ring
    have factor_dvd : 81 ∣ 3240 * offset + 3051 :=
      (product_modEq_two_iff_dvd scale_pos product_eq).mp <| by
        simpa [modulus_eq] using relation
    obtain ⟨quotient, quotient_eq⟩ := factor_dvd
    omega
  · have x_shift :
        swappedCode (true :: true :: List.replicate (width - 1) false) - 1 =
          45 * offset + 43 := by
      rw [scale_eq] at true_code
      omega
    have y_value :
        swappedCode (true :: true :: List.replicate (width - 1) false) =
          45 * offset + 44 := by
      rw [scale_eq] at true_code
      omega
    have product_eq :
        (swappedCode (true :: true :: List.replicate (width - 1) false) - 1) *
            swappedCode (true :: true :: List.replicate (width - 1) false) =
          2 + scale * (2025 * offset + 1890) := by
      rw [x_shift, y_value, scale_eq]
      ring
    have factor_dvd : 81 ∣ 2025 * offset + 1890 :=
      (product_modEq_two_iff_dvd scale_pos product_eq).mp <| by
        simpa [modulus_eq] using relation
    obtain ⟨quotient, quotient_eq⟩ := factor_dvd
    omega

private theorem spell_fringeBlock_length_one {phases : List Bool}
    (length_eq : (spell fringeBlock phases).length = 1) : phases = [false] := by
  cases phases with
  | nil =>
      change 0 = 1 at length_eq
      omega
  | cons phase phases =>
      cases phase with
      | true =>
          change ([true, true, false] ++ spell fringeBlock phases).length = 1 at length_eq
          simp only [List.length_append, List.length_cons, List.length_nil] at length_eq
          omega
      | false =>
          have tail_empty : spell fringeBlock phases = [] := by
            apply List.length_eq_zero_iff.mp
            change (false :: spell fringeBlock phases).length = 1 at length_eq
            simp only [List.length_cons] at length_eq
            omega
          rw [spell_fringeBlock_eq_nil_iff] at tail_empty
          subst phases
          rfl

private theorem spell_fringeBlock_length_two {phases : List Bool}
    (length_eq : (spell fringeBlock phases).length = 2) :
    phases = [false, false] := by
  cases phases with
  | nil =>
      change 0 = 2 at length_eq
      omega
  | cons phase phases =>
      cases phase with
      | true =>
          change ([true, true, false] ++ spell fringeBlock phases).length = 2 at length_eq
          simp only [List.length_append, List.length_cons, List.length_nil] at length_eq
          omega
      | false =>
          have tail_length : (spell fringeBlock phases).length = 1 := by
            change (false :: spell fringeBlock phases).length = 2 at length_eq
            simp only [List.length_cons] at length_eq
            omega
          rw [spell_fringeBlock_length_one tail_length]

private theorem spell_fringeBlock_length_three {phases : List Bool}
    (length_eq : (spell fringeBlock phases).length = 3) :
    phases = [true] ∨ phases = [false, false, false] := by
  cases phases with
  | nil =>
      change 0 = 3 at length_eq
      omega
  | cons phase phases =>
      cases phase with
      | true =>
          have tail_empty : spell fringeBlock phases = [] := by
            apply List.length_eq_zero_iff.mp
            change ([true, true, false] ++ spell fringeBlock phases).length = 3 at length_eq
            simp only [List.length_append, List.length_cons, List.length_nil] at length_eq
            omega
          rw [spell_fringeBlock_eq_nil_iff] at tail_empty
          subst phases
          exact Or.inl rfl
      | false =>
          have tail_length : (spell fringeBlock phases).length = 2 := by
            change (false :: spell fringeBlock phases).length = 3 at length_eq
            simp only [List.length_cons] at length_eq
            omega
          rw [spell_fringeBlock_length_two tail_length]
          exact Or.inr rfl

private theorem boundarySuffix_length_three {word : List Bool}
    (suffix : BoundarySuffix word) (length_eq : word.length = 3) :
    word = List.replicate 3 false ∨
      word = true :: List.replicate 2 false ∨
        word = [true, true, false] := by
  rcases suffix with ⟨phases, rfl⟩ | ⟨phases, rfl⟩
  · rcases spell_fringeBlock_length_three length_eq with rfl | rfl
    · exact Or.inr <| Or.inr rfl
    · exact Or.inl rfl
  · have phase_length : (spell fringeBlock phases).length = 1 := by
      simp at length_eq
      omega
    rw [spell_fringeBlock_length_one phase_length]
    exact Or.inr <| Or.inl rfl

private theorem blockBoundaryInverse_offset (offset : Nat) {x y : List Bool}
    (x_suffix : BlockBoundarySuffix (offset + 3) x)
    (y_suffix : BlockBoundarySuffix (offset + 3) y)
    (relation :
      (swappedCode x - 1) * swappedCode y ≡ 2 [MOD 3 ^ (offset + 3)]) :
    (x = List.replicate (offset + 3) false ∧
        y = List.replicate (offset + 3) false) ∨
      (x = true :: List.replicate (offset + 2) false ∧
        y = true :: List.replicate (offset + 2) false) := by
  induction offset generalizing x y with
  | zero =>
      rcases x_suffix with ⟨x_length, x_boundary⟩
      rcases y_suffix with ⟨y_length, y_boundary⟩
      rcases boundarySuffix_length_three x_boundary (by simpa using x_length) with
          rfl | rfl | rfl <;>
        rcases boundarySuffix_length_three y_boundary (by simpa using y_length) with
          rfl | rfl | rfl <;>
        norm_num [List.replicate, swappedCode, ternaryCode, ternaryDigit, Nat.ofDigits,
          Nat.ModEq] at relation <;>
        norm_num [List.replicate]
  | succ offset induction =>
      rcases x_suffix with ⟨x_length, x_boundary⟩
      rcases y_suffix with ⟨y_length, y_boundary⟩
      have x_ne : x ≠ [] := by
        intro x_empty
        subst x
        simp at x_length
      have y_ne : y ≠ [] := by
        intro y_empty
        subst y
        simp at y_length
      obtain ⟨xHead, xTail, rfl⟩ := List.exists_cons_of_ne_nil x_ne
      obtain ⟨yHead, yTail, rfl⟩ := List.exists_cons_of_ne_nil y_ne
      have x_tail_length : xTail.length = offset + 3 := by
        simp only [List.length_cons] at x_length
        omega
      have y_tail_length : yTail.length = offset + 3 := by
        simp only [List.length_cons] at y_length
        omega
      have tail_relation :
          (swappedCode xTail - 1) * swappedCode yTail ≡ 2
            [MOD 3 ^ (offset + 3)] := by
        apply inverseRelation_tail (by omega) x_tail_length y_tail_length
        simpa [show offset + 1 + 3 = offset + 3 + 1 by omega] using relation
      have tail_shapes := induction
        ⟨x_tail_length, x_boundary.tail⟩ ⟨y_tail_length, y_boundary.tail⟩ tail_relation
      rcases tail_shapes with ⟨x_zero, y_zero⟩ | ⟨x_one, y_one⟩
      · subst xTail
        subst yTail
        have current_relation :
            (swappedCode (xHead :: List.replicate (offset + 3) false) - 1) *
                swappedCode (yHead :: List.replicate (offset + 3) false) ≡ 2
              [MOD 3 ^ (offset + 3 + 1)] := by
          rw [show offset + 3 + 1 = offset + 1 + 3 by omega]
          exact relation
        have heads_eq := zeroTail_heads_eq (by omega) xHead yHead current_relation
        subst yHead
        cases xHead with
        | false =>
            have run_eq :
                false :: List.replicate (offset + 3) false =
                  List.replicate ((offset + 3) + 1) false :=
              (List.replicate_succ (a := false) (n := offset + 3)).symm
            exact Or.inl ⟨by simpa only [show offset + 1 + 3 = offset + 3 + 1 by omega]
                using run_eq,
              by simpa only [show offset + 1 + 3 = offset + 3 + 1 by omega] using run_eq⟩
        | true =>
            exact Or.inr ⟨rfl, rfl⟩
      · subst xTail
        subst yTail
        have x_boundary' :
            BoundarySuffix
              (xHead :: true :: List.replicate ((offset + 3) - 1) false) := by
          simpa only [show offset + 3 - 1 = offset + 2 by omega] using x_boundary
        have current_relation :
            (swappedCode
                  (xHead :: true :: List.replicate ((offset + 3) - 1) false) - 1) *
                swappedCode
                  (yHead :: true :: List.replicate ((offset + 3) - 1) false) ≡ 2
              [MOD 3 ^ (offset + 3 + 1)] := by
          simpa only [show offset + 3 - 1 = offset + 2 by omega,
            show offset + 3 + 1 = offset + 1 + 3 by omega] using relation
        exact False.elim <|
          oneTail_relation_false (by omega) xHead yHead x_boundary' current_relation

/-- Two equally long boundary suffixes satisfying the swapped setter's inverse congruence are
the all-zero suffix or its unique one-bit cut. -/
theorem blockBoundaryInverse {width : Nat} {x y : List Bool}
    (width_large : 3 ≤ width)
    (x_suffix : BlockBoundarySuffix width x)
    (y_suffix : BlockBoundarySuffix width y)
    (relation :
      (swappedCode x - 1) * swappedCode y ≡ 2 [MOD 3 ^ width]) :
    (x = List.replicate width false ∧ y = List.replicate width false) ∨
      (x = true :: List.replicate (width - 1) false ∧
        y = true :: List.replicate (width - 1) false) := by
  let offset := width - 3
  have width_eq : width = offset + 3 := by
    dsimp [offset]
    omega
  rw [width_eq] at x_suffix y_suffix relation ⊢
  simpa only [show offset + 3 - 1 = offset + 2 by omega] using
    blockBoundaryInverse_offset offset x_suffix y_suffix relation

end MatrixMortality.SwappedSetterFringe
